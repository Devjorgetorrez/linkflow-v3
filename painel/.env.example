# Painel SiteFlow — Variáveis de ambiente
# Copiar para .env.local e ajustar antes de npm run build no VPS.
# O install.ps1/install.sh já gera este arquivo com NEXTAUTH_SECRET e
# PAINEL_API_KEY sorteados — LINKFLOW_DIR/LINKFLOW_SLUG abaixo ficam com
# valor de exemplo porque são por cliente: cada skill (fase2-site-astro,
# vps-setup, site-atualizar) os define na hora de abrir o painel de um
# cliente específico, não são um valor fixo de instalação.

# Pasta raiz do motor Astro no servidor (exemplo — troque pelo caminho real)
LINKFLOW_DIR=/opt/linkflow/clientes/slug-do-cliente

# Slug do cliente ativo neste painel (exemplo — troque pelo slug real)
LINKFLOW_SLUG=slug-do-cliente

# Porta do painel (PM2 usa essa porta)
PORT=3210

# Chave de autenticação da API (máquina-a-máquina)
# Gerar com: openssl rand -hex 32
PAINEL_API_KEY=troque-por-uma-chave-segura

# NextAuth — autenticação de usuários do painel
# Gerar secret com: openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-um-secret-seguro
NEXTAUTH_URL=https://painel.seudominio.com.br
