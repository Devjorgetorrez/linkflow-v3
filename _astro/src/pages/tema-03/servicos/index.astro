---
import Tema03Base  from '../../../layouts/Tema03Base.astro'
import Header      from '../../../components/blocos/Header.astro'
import PageHero    from '../../../components/blocos/PageHero.astro'
import Servicos    from '../../../components/blocos/Servicos.astro'
import Prova       from '../../../components/blocos/Prova.astro'
import Abordagem   from '../../../components/blocos/Abordagem.astro'
import Faq         from '../../../components/blocos/Faq.astro'
import Cta         from '../../../components/blocos/Cta.astro'
import Footer      from '../../../components/blocos/Footer.astro'
import { site }    from '../../../config/tema-03.ts'
import { textoCredencial } from '../../../lib/schema.ts'
import { getCollection } from 'astro:content'

const servicos = (await getCollection('servicosT3'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(s => ({
    titulo:    s.data.titulo,
    descricao: s.data.resumo,
    icone:     s.data.icone ?? '',
    imagem:    s.data.imagem,
    imagemAlt: s.data.imagemAlt,
    href:      `/tema-03/${s.id}`,
    categoria: s.data.categoria,
  }))

const canonical = `${site.dominio}/servicos/`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type':    'CollectionPage',
      '@id':      `${canonical}#webpage`,
      url:        canonical,
      name:       `Serviços — ${site.nome}`,
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'BreadcrumbList',
      '@id':   `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'Serviços', item: canonical },
      ],
    },
  ],
}
---

<Tema03Base
  titulo={`Serviços contábeis — ${site.nome}`}
  metaDescription="Contabilidade consultiva, gestão fiscal, departamento pessoal, abertura de empresas, BPO financeiro e planejamento tributário para empresas em Londrina e região."
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="servicos"
>
  <Header
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    variante="padrao"
    nomeSite={site.nome}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Falar com um contador"
    ctaHref="/tema-03/contato"
  />

  <PageHero
    eyebrow="Serviços"
    titulo="Contabilidade, fiscal, pessoal e financeiro no mesmo escritório"
    descricao="Seis frentes que funcionam juntas. Quem cuida da sua folha conversa com quem apura o seu imposto — e os dois falam com quem monta o seu relatório."
  />

  <Servicos
    variante="lista"
    itens={servicos}
  />

  <Prova
    titulo="O que vale para todos os serviços"
    itens={site.diferenciais}
  />

  <Abordagem
    titulo="Setores que já conhecemos por dentro"
    descricao="Cada atividade tem uma armadilha fiscal própria. Estes são os segmentos que o escritório atende com mais profundidade."
    itens={site.setores}
  />

  <Faq
    variante="padrao"
    titulo="Dúvidas sobre contratação"
    itens={site.faq}
  />

  <Cta
    variante="card"
    titulo="Não sabe de qual serviço precisa?"
    descricao="Descreva a situação da sua empresa em duas linhas. Respondemos dizendo o que faz sentido contratar — inclusive quando a resposta é nada por enquanto."
    ctaPrimTexto="Descrever minha situação"
    ctaPrimHref="/tema-03/contato"
    ctaSecTexto="Falar no WhatsApp"
    ctaSecHref={`https://wa.me/${site.nap.whatsapp}`}
  />

  <Footer
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    credencial={textoCredencial(site)}
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema03Base>
