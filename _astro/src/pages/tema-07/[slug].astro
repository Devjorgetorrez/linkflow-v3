---
/**
 * Rota unificada para planos, categorias e posts do Tema 07 — URL plana
 * dentro do prefixo /tema-07/ (que some quando o tema for promovido pra
 * raiz, numa etapa separada). Mesmo padrão do tema base: o slug decide o
 * quê, sem /planos/ nem /blog/ nem /categoria/ no caminho do item
 * individual.
 *
 * Prioridade em caso de slug repetido (decisão do Jorge): página fixa >
 * plano > categoria > artigo.
 */
import ServicoDetalheT7 from '../../components/paginas/ServicoDetalheT7.astro'
import CategoriaDetalheT7 from '../../components/paginas/CategoriaDetalheT7.astro'
import PostDetalheT7 from '../../components/paginas/PostDetalheT7.astro'
import { getCollection } from 'astro:content'
import { ehPublicado } from '../../lib/publicacao.ts'

export async function getStaticPaths() {
  // Declarado DENTRO de getStaticPaths: o Astro isola essa função num
  // chunk próprio de pré-renderização e não inclui const do escopo do
  // módulo declarada fora dela.
  const RESERVADOS = new Set([
    'sobre', 'contato', 'planos', 'blog', 'autor',
    'como-escolher-plano-de-saude',
    'politica-de-privacidade', 'termos-de-uso',
  ])

  const planos = await getCollection('servicosT7')
  const categorias = await getCollection('categoriasT7')
  const posts = await getCollection('postsT7', ehPublicado)

  const pathsPlanos = planos
    .filter(s => {
      if (RESERVADOS.has(s.id)) {
        console.error(`tema-07/[slug].astro: plano "${s.id}" colide com página fixa — ignorado. Troque o slug do plano.`)
        return false
      }
      return true
    })
    .map(s => ({ params: { slug: s.id }, props: { tipo: 'plano' as const, entry: s } }))

  const slugsPlanos = new Set(pathsPlanos.map(p => p.params.slug))

  const pathsCategorias = categorias
    .filter(c => {
      if (RESERVADOS.has(c.id)) {
        console.error(`tema-07/[slug].astro: categoria "${c.id}" colide com página fixa — ignorada. Troque o slug da categoria.`)
        return false
      }
      if (slugsPlanos.has(c.id)) {
        console.error(`tema-07/[slug].astro: colisão de slug "${c.id}" entre servicosT7 e categoriasT7 — a categoria foi ignorada nesta URL, o plano prevalece. Troque o slug da categoria.`)
        return false
      }
      return true
    })
    .map(c => ({ params: { slug: c.id }, props: { tipo: 'categoria' as const, entry: c } }))

  const slugsCategorias = new Set(pathsCategorias.map(p => p.params.slug))

  const pathsPosts = posts
    .filter(p => {
      if (RESERVADOS.has(p.id)) {
        console.error(`tema-07/[slug].astro: post "${p.id}" colide com página fixa — ignorado. Troque o slug do post.`)
        return false
      }
      if (slugsPlanos.has(p.id)) {
        console.error(
          `tema-07/[slug].astro: colisão de slug "${p.id}" entre servicosT7 e postsT7 — ` +
          `o post foi ignorado nesta URL, o plano prevalece. Troque o slug do post.`
        )
        return false
      }
      if (slugsCategorias.has(p.id)) {
        console.error(`tema-07/[slug].astro: colisão de slug "${p.id}" entre categoriasT7 e postsT7 — o post foi ignorado nesta URL, a categoria prevalece. Troque o slug do post.`)
        return false
      }
      return true
    })
    .map(p => ({
      params: { slug: p.id },
      props: { tipo: 'post' as const, entry: p },
    }))

  return [...pathsPlanos, ...pathsCategorias, ...pathsPosts]
}

const { tipo, entry } = Astro.props
---

{tipo === 'plano' && <ServicoDetalheT7 entry={entry} />}
{tipo === 'categoria' && <CategoriaDetalheT7 entry={entry} />}
{tipo === 'post' && <PostDetalheT7 entry={entry} />}
