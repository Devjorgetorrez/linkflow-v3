/* ── helper de rótulo de seção ─────────────────────────────────── */
---

<Base titulo="SiteFlow — Demo de Blocos">

  {/* ── indicador de seção ────────────────────────────────────────── */}
  <style>
    .demo-label {
      background: var(--color-secondary);
      color: var(--color-surface);
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: 6px 16px;
    }
    .demo-sep {
      height: 2px;
      background: var(--color-primary);
      margin: 0;
    }
  </style>

  {/* ══════════════════════════════════════════════════════════════ */}
  {/*  HEADER — 4 variantes                                         */}
  {/* ══════════════════════════════════════════════════════════════ */}

  <div class="demo-label">Header · padrao</div>
  <Header variante="padrao" {...hdr} />
  <hr class="demo-sep" />

  <div class="demo-label">Header · minimal</div>
  <Header variante="minimal" {...hdr} />
  <hr class="demo-sep" />

  <div class="demo-label">Header · centrado</div>
  <Header variante="centrado" {...hdr} />
  <hr class="demo-sep" />

  {/*
    transparente: Header gerencia o <slot> internamente.
    Hero split é passado como filho — aparece abaixo do header absoluto,
    com --header-offset aplicado automaticamente na coluna de texto.
  */}
  <div class="demo-label">Header · transparente  →  com Hero split abaixo</div>
  <Header variante="transparente" {...hdr}>
    <Hero variante="split" {...hero} imagem="/demo-foto.jpg" />
  </Header>
  <hr class="demo-sep" />

  {/* ══════════════════════════════════════════════════════════════ */}
  {/*  HERO — 6 variantes (cada um com Header padrao para contexto)  */}
  {/* ══════════════════════════════════════════════════════════════ */}

  <div class="demo-label">Hero · texto</div>
  <Hero variante="texto" {...hero} />
  <hr class="demo-sep" />

  <div class="demo-label">Hero · imagem  (fallback sem foto — coluna colapsa)</div>
  <Hero variante="imagem" {...hero} />
  <hr class="demo-sep" />

  <div class="demo-label">Hero · video  (sem videoUrl → bg-secondary puro)</div>
  <Hero variante="video" {...hero} />
  <hr class="demo-sep" />

  <div class="demo-label">Hero · landing</div>
  <Hero variante="landing" {...hero} />
  <hr class="demo-sep" />

  <div class="demo-label">Hero · split  (sem imagem → coluna bg-surface-2)</div>
  <Hero variante="split" {...hero} />
  <hr class="demo-sep" />

  <div class="demo-label">Hero · editorial</div>
  <Hero variante="editorial" {...hero} />
  <hr class="demo-sep" />

  {/* ══════════════════════════════════════════════════════════════ */}
  {/*  SERVICOS — 4 variantes                                        */}
  {/* ══════════════════════════════════════════════════════════════ */}

  <div class="demo-label">Servicos · grade</div>
  <Servicos variante="grade"
            titulo="Serviços"
            descricao="Atendimento presencial em Caieiras e online para todo o Brasil."
            itens={servicos} />
  <hr class="demo-sep" />

  <div class="demo-label">Servicos · lista</div>
  <Servicos variante="lista"
            titulo="O que oferecemos"
            itens={servicos} />
  <hr class="demo-sep" />

  <div class="demo-label">Servicos · destaque</div>
  <Servicos variante="destaque"
            titulo="Serviços"
            itens={servicos} />
  <hr class="demo-sep" />

  <div class="demo-label">Servicos · tabs  (por categoria: Clínica · Avaliação)</div>
  <Servicos variante="tabs"
            titulo="Serviços por área"
            itens={servicos} />
  <hr class="demo-sep" />

  {/* ══════════════════════════════════════════════════════════════ */}
  {/*  FOOTER — 3 variantes                                          */}
  {/* ══════════════════════════════════════════════════════════════ */}

  <div class="demo-label">Footer · padrao</div>
  <Footer variante="padrao" {...footer} />
  <hr class="demo-sep" />

  <div class="demo-label">Footer · minimal</div>
  <Footer variante="minimal" {...footer} />
  <hr class="demo-sep" />

  <div class="demo-label">Footer · colunas</div>
  <Footer variante="colunas" {...footer} />

</Base>
