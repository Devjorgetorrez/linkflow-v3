---
import Tema05Base  from '../../../layouts/Tema05Base.astro'
import Header      from '../../../components/blocos/Header.astro'
import PageHero    from '../../../components/blocos/PageHero.astro'
import Servicos    from '../../../components/blocos/Servicos.astro'
import Prova       from '../../../components/blocos/Prova.astro'
import Passos      from '../../../components/blocos/Passos.astro'
import Numeros     from '../../../components/blocos/Numeros.astro'
import Faq         from '../../../components/blocos/Faq.astro'
import Cta         from '../../../components/blocos/Cta.astro'
import Footer      from '../../../components/blocos/Footer.astro'
import { site }    from '../../../config/tema-05.ts'
import { textoCredencial, rotuloNav } from '../../../lib/schema.ts'
import { getCollection } from 'astro:content'

const servicos = (await getCollection('servicosT5'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(s => ({
    titulo: s.data.titulo, descricao: s.data.resumo, icone: s.data.icone ?? '',
    imagem: s.data.imagem, imagemAlt: s.data.imagemAlt,
    href: `/tema-05/${s.id}`, categoria: s.data.categoria,
  }))

const canonical = `${site.dominio}/servicos/`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${canonical}#webpage`, url: canonical,
      name: `Áreas de atuação — ${site.nome}`, inLanguage: 'pt-BR' },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',    item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: rotuloNav(site, '/servicos', 'Atuação'), item: canonical },
      ] },
  ],
}
---

<Tema05Base
  titulo={`Áreas de atuação — ${site.nome}`}
  metaDescription="Aposentadorias, BPC/LOAS, auxílio por incapacidade, pensão por morte e regime próprio de servidores públicos, na via administrativa e judicial em Belo Horizonte."
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="servicos"
>
  <Header logoSrc={site.logo?.src} logoAlt={site.logo?.alt} variante="padrao" nomeSite={site.nome} telefone={site.nap.telefone}
          whatsapp={site.nap.whatsapp} nav={site.nav}
          ctaTexto="Agendar atendimento" ctaHref="/tema-05/contato" />

  <PageHero
    variante="destaque"
    eyebrow={rotuloNav(site, '/servicos', 'Atuação')}
    titulo="Direito previdenciário, e só ele"
    descricao="Seis frentes que cobrem os benefícios do INSS e o regime próprio de previdência. Fora dessa área, indicamos um colega em vez de aceitar o caso."
  />

  <Servicos variante="lista" itens={servicos} />

  <Prova variante="faixa" titulo="O que vale para qualquer caso" itens={site.selos} />

  <Passos
    variante="cards"
    titulo="Como conduzimos um caso"
    descricao="A ordem é a mesma para qualquer benefício. O que muda é a documentação de cada etapa."
    itens={site.passos}
  />

  <Numeros variante="escuro" titulo="O escritório em números" itens={site.numeros} nota={site.numerosNota} />

  <Faq variante="duas-colunas" titulo="Dúvidas frequentes" itens={site.faq} />

  <Cta
    variante="card"
    titulo="Não sabe em qual dessas o seu caso se encaixa?"
    descricao="Descreva a situação em duas linhas. Dizemos qual é a via aplicável — e se não houver fundamento, dizemos isso também."
    ctaPrimTexto="Agendar atendimento"
    ctaPrimHref="/tema-05/contato"
    ctaSecTexto="Entender o processo"
    ctaSecHref="/tema-05/direito-previdenciario"
  />

  <Footer credencial={textoCredencial(site)} logoSrc={site.logo?.src} logoAlt={site.logo?.alt}
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema05Base>
