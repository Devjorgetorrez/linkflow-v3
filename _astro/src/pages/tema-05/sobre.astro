---
import Tema05Base   from '../../layouts/Tema05Base.astro'
import Header       from '../../components/blocos/Header.astro'
import PageHero     from '../../components/blocos/PageHero.astro'
import Proposito    from '../../components/blocos/Proposito.astro'
import Prova        from '../../components/blocos/Prova.astro'
import Equipe       from '../../components/blocos/Equipe.astro'
import Numeros      from '../../components/blocos/Numeros.astro'
import Abordagem    from '../../components/blocos/Abordagem.astro'
import Depoimentos  from '../../components/blocos/Depoimentos.astro'
import Cta          from '../../components/blocos/Cta.astro'
import Footer       from '../../components/blocos/Footer.astro'
import { site }     from '../../config/tema-05.ts'
import { getCollection } from 'astro:content'

const equipe = (await getCollection('equipeT5'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(m => ({ nome: m.data.nome, cargo: m.data.cargo, crm: m.data.registro,
               especialidade: m.data.especialidade, foto: m.data.foto }))

const depoimentos = (await getCollection('depoimentosT5'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(d => ({ nome: d.data.nome, cidade: d.data.cidade, servico: d.data.servico, corpo: d.body.trim() }))

const anos      = new Date().getFullYear() - site.anoFundacao
const canonical = `${site.dominio}/sobre`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'AboutPage', '@id': `${canonical}#webpage`, url: canonical,
      name: `O escritório — ${site.nome}`, about: { '@id': `${site.dominio}/#organization` }, inLanguage: 'pt-BR' },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',          item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'O escritório',  item: canonical },
      ] },
  ],
}
---

<Tema05Base
  titulo={`O escritório — ${site.nomeLongo}`}
  metaDescription="Conheça o Amparo Advocacia: escritório dedicado exclusivamente a direito previdenciário em Belo Horizonte desde 2011, com quatro advogados inscritos na OAB/MG."
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="sobre"
>
  <Header variante="padrao" nomeSite={site.nome} telefone={site.nap.telefone}
          whatsapp={site.nap.whatsapp} nav={site.nav}
          ctaTexto="Agendar atendimento" ctaHref="/tema-05/contato" />

  <PageHero
    variante="destaque"
    eyebrow="O escritório"
    titulo={`${anos} anos em uma área só`}
    descricao="Direito previdenciário desde 2011, sem outras áreas. A especialização é o que permite acompanhar mudança de regra e de jurisprudência com a frequência que essa matéria exige."
  />

  <Proposito
    eyebrow="Como começou"
    titulo="A decisão que nunca foi revista"
    paragrafos={[
      `O escritório abriu em ${site.anoFundacao} com dois advogados e uma escolha incômoda: recusar tudo que não fosse previdenciário. Nos primeiros anos isso significou dispensar casos que pagariam a conta do mês.`,
      'A aposta era simples. Regra de transição, tempo especial e critério de renda mudam o tempo todo, e acompanhar isso exige leitura semanal, não consulta esporádica quando o caso aparece.',
      'Hoje somos quatro advogados e uma equipe de apoio. O compromisso que fazemos na primeira conversa continua o mesmo: dizer quando o caso não tem fundamento, ainda que essa seja a resposta que menos gera contrato.',
    ]}
    imagemSrc="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=760&h=620&fit=crop&auto=format"
    imagemAlt="Biblioteca jurídica do escritório"
  />

  <Prova variante="faixa" titulo="O que garantimos a qualquer cliente" itens={site.selos} />

  <Equipe
    variante="grade"
    titulo="Os advogados"
    descricao="Todos inscritos na OAB/MG. O profissional que analisa o caso é o que conversa com você do início ao fim."
    membros={equipe}
  />

  <Numeros variante="escuro" titulo="O escritório em números" itens={site.numeros} nota={site.numerosNota} />

  <Abordagem
    titulo="Como conduzimos um caso"
    descricao="Seis práticas fixas, que valem para qualquer benefício e para qualquer cliente."
    itens={site.diferenciais}
  />

  <Depoimentos
    titulo="Relatos de quem já foi atendido"
    itens={depoimentos}
    notaMedia="4,9"
    totalAvaliacoes="+140"
    fonteAvaliacoes="avaliações no Google"
  />

  <Cta
    variante="card"
    titulo="Quer conversar antes de decidir?"
    descricao="A conversa inicial é para entender a sua história de contribuição e dizer, com honestidade, o que o caso comporta."
    ctaPrimTexto="Agendar atendimento"
    ctaPrimHref="/tema-05/contato"
    ctaSecTexto="Ver áreas de atuação"
    ctaSecHref="/tema-05/servicos"
  />

  <Footer
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema05Base>
