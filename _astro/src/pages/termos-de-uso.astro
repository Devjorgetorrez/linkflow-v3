---
/**
 * Termos de Uso — página OBRIGATÓRIA em todo site (regra do Jorge: uma das
 * 4 institucionais da lista fechada do fase3-conteudo). Indexável, sem aviso
 * de página opcional. O corpo vem de `site.legal.termos` (+ razão social/CNPJ
 * de `site.legal.controlador`) via <ConteudoLegal documento="termos">, com as
 * 7 seções exigidas pelo guardiao_institucionais.py.
 */
import ThemeBase     from '../layouts/ThemeBase.astro'
import Header        from '../components/blocos/Header.astro'
import PageHero      from '../components/blocos/PageHero.astro'
import ConteudoLegal from '../components/blocos/ConteudoLegal.astro'
import Footer        from '../components/blocos/Footer.astro'
import { site }      from '../config/site.ts'

import { textoCredencial } from '../lib/schema.ts'
const canonical = `${site.dominio}/termos-de-uso/`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type':    'WebPage',
      '@id':      `${canonical}#webpage`,
      url:        canonical,
      name:       `Termos de Uso — ${site.nome}`,
      inLanguage: 'pt-BR',
      isPartOf:   { '@id': `${site.dominio}/#website` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id':   `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'Termos de Uso', item: canonical },
      ],
    },
  ],
}
---

<ThemeBase
  titulo={`Termos de Uso — ${site.nome}`}
  metaDescription={`Termos de uso do site da ${site.nome}: finalidade do conteúdo publicado, relação com o atendimento prestado e tratamento de dados pessoais.`}
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="termos-de-uso"
>
  <Header
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    variante="padrao"
    nomeSite={site.nome}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Agendar Consulta"
    ctaHref="/contato"
  />

  <PageHero
    eyebrow="Legal"
    titulo="Termos de Uso"
    descricao="Regras de navegação neste site e relação entre o conteúdo publicado e o atendimento prestado."
  />

  <ConteudoLegal legal={site.legal} nomeSite={site.nome} documento="termos" />

  <Footer
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    credencial={textoCredencial(site)}
    variante="escuro"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</ThemeBase>
