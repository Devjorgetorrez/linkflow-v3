---
/** Artigo do Tema 06 — mesmo padrão de autor dos temas anteriores. */
import Tema06Base  from '../../../layouts/Tema06Base.astro'
import Header      from '../../../components/blocos/Header.astro'
import Autor       from '../../../components/blocos/Autor.astro'
import PostLista   from '../../../components/blocos/PostLista.astro'
import Cta         from '../../../components/blocos/Cta.astro'
import Footer      from '../../../components/blocos/Footer.astro'
import { site }    from '../../../config/tema-06.ts'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('postsT6')
  return posts.map(p => ({ params: { id: p.id }, props: { entry: p } }))
}

const { entry }   = Astro.props
const { Content } = await render(entry)
const canonical   = `${site.dominio}/blog/${entry.id}`
const wa          = `https://wa.me/${site.nap.whatsapp}`

const dataFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date(entry.data.publicadoEm + 'T12:00:00'))

const relacionados = (await getCollection('postsT6'))
  .filter(p => p.id !== entry.id)
  .sort((a, b) => new Date(b.data.publicadoEm).getTime() - new Date(a.data.publicadoEm).getTime())
  .map(p => ({
    titulo: p.data.titulo, publicadoEm: p.data.publicadoEm, categoria: p.data.categoria,
    imagemCapa: p.data.imagemCapa, imagemCapaAlt: p.data.imagemCapaAlt,
    autor: p.data.autor, href: `/tema-06/blog/${p.id}`,
  }))

const shareUrl  = encodeURIComponent(canonical)
const shareText = encodeURIComponent(entry.data.titulo)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting', '@id': `${canonical}#article`,
      headline: entry.data.titulo, description: entry.data.metaDescription,
      datePublished: entry.data.publicadoEm, dateModified: entry.data.publicadoEm,
      inLanguage: 'pt-BR', image: entry.data.imagemCapa, articleSection: entry.data.categoria,
      author: {
        '@type': 'Person', name: entry.data.autor, jobTitle: entry.data.autorCargo,
        image: entry.data.autorFoto, worksFor: { '@id': `${site.dominio}/#organization` },
      },
      publisher: { '@id': `${site.dominio}/#organization` },
      mainEntityOfPage: { '@id': `${canonical}#webpage` },
    },
    {
      '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.dominio}/blog` },
        { '@type': 'ListItem', position: 3, name: entry.data.titulo, item: canonical },
      ],
    },
  ],
}
---

<Tema06Base
  titulo={`${entry.data.titulo} — ${site.nome}`}
  metaDescription={entry.data.metaDescription}
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="post"
>
  <Header
    variante="padrao"
    nomeSite={site.nome}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Quero um orçamento"
    ctaHref={wa}
  />

  <article>
    <div class="border-b border-line bg-surface-2 py-12">
      <div class="container-wide max-w-[760px]">
        <nav class="mb-5 text-xs text-ink-muted" aria-label="Breadcrumb">
          <a href="/tema-06" class="no-underline transition-colors hover:text-primary">Home</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <a href="/tema-06/blog" class="no-underline transition-colors hover:text-primary">Blog</a>
          {entry.data.categoria && (
            <>
              <span class="mx-1.5 text-ink-muted/50">›</span>
              <span>{entry.data.categoria}</span>
            </>
          )}
        </nav>

        {entry.data.categoria && (
          <span class="mb-3 inline-block rounded-[var(--radius-btn)] bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            {entry.data.categoria}
          </span>
        )}

        <h1 class="mb-6 font-display text-[clamp(1.625rem,4vw,2.5rem)] font-bold leading-tight text-secondary">
          {entry.data.titulo}
        </h1>

        <Autor
          variante="byline"
          nome={entry.data.autor}
          foto={entry.data.autorFoto}
          cargo={entry.data.autorCargo}
          data={dataFormatada}
        />
      </div>
    </div>

    {entry.data.imagemCapa && (
      <div class="container-wide max-w-[760px] pt-10">
        <div class="overflow-hidden rounded-[var(--radius-card)]">
          <img src={entry.data.imagemCapa}
               alt={entry.data.imagemCapaAlt ?? entry.data.titulo}
               width="760" height="420" class="max-h-[420px] w-full object-cover" loading="eager" />
        </div>
      </div>
    )}

    <div class="container-wide max-w-[760px] py-12">
      <div class="article-body"><Content /></div>

      <div class="mt-10 border-t border-line pt-8">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-muted">Compartilhar</p>
        <div class="flex flex-wrap gap-2">
          <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener noreferrer"
             class="rounded-[var(--radius-btn)] border border-line px-4 py-2 text-xs font-semibold text-ink no-underline transition-colors hover:border-primary hover:text-primary">WhatsApp</a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener noreferrer"
             class="rounded-[var(--radius-btn)] border border-line px-4 py-2 text-xs font-semibold text-ink no-underline transition-colors hover:border-primary hover:text-primary">Facebook</a>
          <a href={`mailto:?subject=${shareText}&body=${shareUrl}`}
             class="rounded-[var(--radius-btn)] border border-line px-4 py-2 text-xs font-semibold text-ink no-underline transition-colors hover:border-primary hover:text-primary">E-mail</a>
        </div>
      </div>

      <Autor
        variante="assinatura"
        nome={entry.data.autor}
        foto={entry.data.autorFoto}
        cargo={entry.data.autorCargo}
        bio={entry.data.autorBio}
        email={entry.data.autorEmail}
        whatsapp={site.nap.whatsapp}
      />
    </div>
  </article>

  <PostLista variante="grade" titulo="Outros artigos" posts={relacionados} verMaisHref="/tema-06/blog" />

  <Cta
    variante="padrao"
    titulo="Quer que a gente veja o seu caso?"
    descricao="O artigo explica o geral. Para saber o que está acontecendo no seu imóvel, mande uma foto no WhatsApp."
    ctaPrimTexto="Chamar no WhatsApp"
    ctaPrimHref={wa}
    ctaSecTexto="Ver os serviços"
    ctaSecHref="/tema-06/servicos"
  />

  <Footer
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema06Base>
