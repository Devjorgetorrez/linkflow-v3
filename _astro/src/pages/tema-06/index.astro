---
/**
 * Home do Tema 06 — serviço técnico de emergência.
 *
 * O visitante chega com um problema que já está acontecendo: mancha na
 * parede, conta alta, esgoto voltando. A página responde em ordem de
 * urgência — o que fazemos, como localizamos sem quebrar, onde atendemos
 * e em quanto tempo chegamos.
 */
import Tema06Base   from '../../layouts/Tema06Base.astro'
import Header       from '../../components/blocos/Header.astro'
import Hero         from '../../components/blocos/Hero.astro'
import Prova        from '../../components/blocos/Prova.astro'
import Servicos     from '../../components/blocos/Servicos.astro'
import Passos       from '../../components/blocos/Passos.astro'
import AreaAtendida from '../../components/blocos/AreaAtendida.astro'
import Proposito    from '../../components/blocos/Proposito.astro'
import Numeros      from '../../components/blocos/Numeros.astro'
import Faq          from '../../components/blocos/Faq.astro'
import Cta          from '../../components/blocos/Cta.astro'
import Depoimentos  from '../../components/blocos/Depoimentos.astro'
import Localizacao  from '../../components/blocos/Localizacao.astro'
import PostLista    from '../../components/blocos/PostLista.astro'
import BuscasFrequentes from '../../components/blocos/BuscasFrequentes.astro'
import Footer       from '../../components/blocos/Footer.astro'
import { site }     from '../../config/tema-06.ts'
import { tituloOuPadrao, metaOuPadrao } from '../../lib/paginaFixa.ts'
import { textoCredencial, organizacaoSchema, areaLista } from '../../lib/schema.ts'
import { getCollection } from 'astro:content'
import { ehPublicado } from '../../lib/publicacao.ts'
import { nomeAutor } from '../../lib/autores.ts'
import { nomeCategoria } from '../../lib/categorias.ts'

const servicos = (await getCollection('servicosT6'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(s => ({
    titulo: s.data.titulo, descricao: s.data.resumo, icone: s.data.icone ?? '',
    imagem: s.data.imagem, imagemAlt: s.data.imagemAlt,
    href: `/tema-06/${s.id}`, categoria: s.data.categoria,
  }))

const depoimentos = (await getCollection('depoimentosT6'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(d => ({ nome: d.data.nome, cidade: d.data.cidade, servico: d.data.servico, corpo: d.body.trim() }))

const autores = await getCollection('autoresT6')
const categorias = await getCollection('categoriasT6')
const posts = (await getCollection('postsT6', ehPublicado))
  .sort((a, b) => new Date(b.data.publicadoEm).getTime() - new Date(a.data.publicadoEm).getTime())
  .map(p => ({
    titulo: p.data.titulo, publicadoEm: p.data.publicadoEm, categoria: nomeCategoria(p.data.categoria, categorias),
    imagemCapa: p.data.imagemCapa, imagemCapaAlt: p.data.imagemCapaAlt, resumo: p.data.resumo,
    autor: nomeAutor(p.data, autores), href: `/tema-06/${p.id}`,
  }))

const anos      = site.anoFundacao ? new Date().getFullYear() - site.anoFundacao : null
const wa        = `https://wa.me/${site.nap.whatsapp}`
const canonical = `${site.dominio}/`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizacaoSchema(site, ['Plumber', 'LocalBusiness'], { name: site.nomeLongo }),
    {
      '@type': 'WebSite', '@id': `${site.dominio}/#website`,
      url: site.dominio, name: site.nome,
      publisher: { '@id': `${site.dominio}/#organization` }, inLanguage: 'pt-BR',
    },
    {
      '@type': 'WebPage', '@id': `${canonical}#webpage`,
      url: canonical, name: `${site.nomeLongo} em ${site.nap.cidade}`,
      isPartOf: { '@id': `${site.dominio}/#website` },
      about: { '@id': `${site.dominio}/#organization` }, inLanguage: 'pt-BR',
    },
    {
      '@type': 'FAQPage', '@id': `${canonical}#faq`,
      mainEntity: site.faq.map(f => ({
        '@type': 'Question', name: f.pergunta,
        acceptedAnswer: { '@type': 'Answer', text: f.resposta },
      })),
    },
  ],
}
---

<Tema06Base
  titulo={tituloOuPadrao(site, 'home', `Caça Vazamento e Encanador em ${site.nap.cidade} — ${site.nome}`)}
  metaDescription={metaOuPadrao(site, 'home', "Caça vazamento, detecção de infiltração e serviço de encanador em Goiânia e região. Localizamos o ponto sem quebrar, com laudo técnico e plantão de emergência.")}
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="home"
>

  <Header
    variante="padrao"
    nomeSite={site.nome}
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Quero um orçamento"
    ctaHref={wa}
  />

  {/* 1 — o problema e a promessa, com ação imediata */}
  <Hero
    variante="destaque"
    titulo={`Caça vazamento e encanador em ${site.nap.cidade} e região`}
    lead="Localizamos o ponto exato com termografia, geofone e gás traçador — antes de abrir piso ou parede. Reparo pela mesma equipe e laudo técnico ao final."
    ctaPrimTexto="Chamar agora no WhatsApp"
    ctaPrimHref={wa}
    ctaSecTexto="Ver os serviços"
    ctaSecHref="/tema-06/servicos"
    nota="Plantão de emergência até as 22h, todos os dias. Sem taxa de deslocamento em Goiânia."
    imagem="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=560&h=460&fit=crop&auto=format"
    imagemAlt="Inspeção termográfica em parede residencial"
    provaNumero={anos ? `+${anos} anos` : undefined}
    provaTexto={`atendendo ${site.nap.cidade} e região`}
  />

  {/* 2 — as três objeções imediatas, em faixa encostada no hero */}
  <Prova variante="faixa" sobrepor={true} itens={site.selos} />

  {/* 3 — o que resolvemos */}
  <Servicos
    variante="grade"
    titulo="O que fazemos"
    descricao="Detecção e reparo hidráulico em imóvel residencial, comercial e condomínio."
    itens={servicos}
  />

  {/* 4 — como funciona, que é o que diferencia detecção de tentativa */}
  <Passos
    variante="numerado"
    titulo="Como resolvemos"
    descricao="Quatro etapas na mesma ordem, em qualquer chamado. É o que evita quebra desnecessária."
    itens={site.passos}
    notaTitulo="Por que essa ordem importa"
    nota="Quebrar onde a mancha aparece é o erro mais caro dessa área. A água corre pelo contrapiso e emerge longe da origem — por isso localizar vem sempre antes de abrir."
  />

  {/* 5 — "vocês atendem meu bairro?" */}
  <AreaAtendida
    eyebrow="Cobertura"
    titulo={`Atendemos ${site.nap.cidade} e toda a região`}
    descricao="Equipe própria, uniformizada e com responsável técnico identificado. Se o seu bairro não estiver na lista, pergunte: a rota muda conforme o dia."
    regioes={areaLista(site)}
    bullets={site.regioesBullets}
    imagem="https://images.unsplash.com/photo-1449844908441-8829872d2607?w=420&h=480&fit=crop&auto=format"
    imagemAlt="Rua residencial arborizada"
    selo={`${site.nap.cidade} e região metropolitana`}
    ctaTexto="Consultar meu bairro"
    ctaHref={wa}
  />

  {/* 6 — quem somos, depois de já ter mostrado método */}
  <Proposito
    eyebrow="Quem somos"
    titulo="Treze anos procurando água onde ninguém vê"
    paragrafos={[
      `A Hidroponto começou ${site.anoFundacao ? `em ${site.anoFundacao}` : 'há alguns anos'} com um geofone emprestado e um carro. O primeiro cliente foi um condomínio que tinha aberto trinta metros de piso sem achar o vazamento.`,
      'Desde então a lógica do trabalho não mudou: equipamento serve para localizar, não para impressionar. Câmera termográfica, geofone e gás traçador resolvem casos diferentes, e escolher o errado custa tempo do cliente.',
      'Hoje são três equipes em rota e plantão de emergência até as 22h. O indicador que acompanhamos de perto é a taxa de localização sem quebra, que segue acima de 90%.',
    ]}
    imagemSrc="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=760&h=620&fit=crop&auto=format"
    imagemAlt="Técnico em serviço de manutenção hidráulica"
  />

  {/* 7 — escala da operação */}
  <Numeros variante="escuro" titulo="A operação em números" itens={site.numeros} nota={site.numerosNota} />

  {/* 8 — diretrizes em acordeão com imagem */}
  <Faq
    variante="com-imagem"
    titulo="Nossas diretrizes"
    descricao="Como trabalhamos, no detalhe que costuma decidir a contratação."
    itens={site.diretrizes}
    imagem="https://images.unsplash.com/photo-1504148455328-c376907d081c?w=400&h=520&fit=crop&auto=format"
    imagemAlt="Ferramentas e equipamentos de detecção"
  />

  <Cta
    variante="padrao"
    titulo="Está com vazamento ou infiltração agora?"
    descricao="Mande uma foto do problema no WhatsApp. Dizemos o que provavelmente é, se dá para inspecionar hoje e quanto custa a visita técnica."
    ctaPrimTexto="Chamar no WhatsApp"
    ctaPrimHref={wa}
    ctaSecTexto="Ver perguntas frequentes"
    ctaSecHref="/tema-06/caca-vazamento"
  />

  {/* 9 — prova social */}
  <Depoimentos
    titulo="Quem já chamou"
    descricao="Clientes atendidos em Goiânia e região metropolitana."
    itens={depoimentos}
    notaMedia={site.avaliacao.nota}
    totalAvaliacoes={site.avaliacao.total}
    fonteAvaliacoes={site.avaliacao.fonte}
  />

  {/* 10 — NAP completo e mapa */}
  <Localizacao
    titulo="Onde estamos"
    descricao="Base no Setor Bueno. O serviço é feito no seu imóvel — a base recebe apenas o agendamento e a retirada de equipamento."
    logradouro={site.nap.logradouro}
    complemento={site.nap.complemento}
    bairro={site.nap.bairro}
    cidade={site.nap.cidade}
    uf={site.nap.uf}
    cep={site.nap.cep}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    email={site.nap.email}
    horarios={site.horarios}
    mapaSrc={site.mapaSrc}
    mapaHref={`https://maps.google.com/?q=${encodeURIComponent(site.nap.enderecoFormatado)}`}
  />

  <PostLista
    variante="destaque"
    titulo="Do blog"
    descricao="O que explicamos na porta do cliente, escrito para quem ainda está tentando entender o problema."
    posts={posts}
    verMaisHref="/tema-06/blog"
  />

  <BuscasFrequentes titulo={`Buscas frequentes — ${site.nome}`} itens={site.buscasFrequentes} />

  <Footer
    variante="colunas"
    nomeSite={site.nome}
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    credencial={textoCredencial(site)}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />

</Tema06Base>
