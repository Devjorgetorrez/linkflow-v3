---
/**
 * Termos de Uso — página OBRIGATÓRIA em todo site (uma das 4 institucionais
 * da lista fechada do fase3-conteudo). Indexável, sem aviso de página
 * opcional. O corpo vem de `site.legal.termos` (+ razão social/CNPJ de
 * `site.legal.controlador`) via <ConteudoLegal documento="termos">.
 */
import Tema06Base    from '../../layouts/Tema06Base.astro'
import Header        from '../../components/blocos/Header.astro'
import PageHero      from '../../components/blocos/PageHero.astro'
import ConteudoLegal from '../../components/blocos/ConteudoLegal.astro'
import Footer        from '../../components/blocos/Footer.astro'
import { site }      from '../../config/tema-06.ts'

import { textoCredencial } from '../../lib/schema.ts'
const wa        = `https://wa.me/${site.nap.whatsapp}`
const canonical = `${site.dominio}/termos-de-uso/`

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical,
      name: `Termos de Uso — ${site.nome}`, inLanguage: 'pt-BR',
      isPartOf: { '@id': `${site.dominio}/#website` } },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'Termos de Uso', item: canonical },
      ] },
  ],
}
---

<Tema06Base
  titulo={`Termos de Uso — ${site.nome}`}
  metaDescription={`Termos de uso do site da ${site.nome}: finalidade do conteúdo publicado, relação com o serviço contratado e tratamento de dados pessoais.`}
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="termos-de-uso"
>
  <Header
    variante="padrao"
    nomeSite={site.nome}
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Quero um orçamento"
    ctaHref={wa}
  />

  <PageHero
    variante="destaque"
    eyebrow="Legal"
    titulo="Termos de Uso"
    descricao="Regras de navegação neste site e relação entre o conteúdo publicado e o serviço contratado."
  />

  <ConteudoLegal legal={site.legal} nomeSite={site.nome} documento="termos" />

  <Footer
    variante="colunas"
    nomeSite={site.nome}
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    credencial={textoCredencial(site)}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema06Base>
