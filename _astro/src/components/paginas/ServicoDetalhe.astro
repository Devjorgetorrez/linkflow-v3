---
import Cta       from '../../components/blocos/Cta.astro'
import Footer     from '../../components/blocos/Footer.astro'
import Header     from '../../components/blocos/Header.astro'
import { site }  from '../../config/site.ts'
import { textoCredencial } from '../../lib/schema.ts'
import { getCollection, render } from 'astro:content'

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'servicos'>>>[number]
}

const { entry } = Astro.props
const { Content } = await render(entry)
const canonical = `${site.dominio}/${entry.id}/`

/* Depoimentos */
const todosDepoimentos = await getCollection('depoimentos')
const depoimentos = todosDepoimentos
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3)

const beneficios = site.beneficios ?? []

// site.processo usa numero/descricao — mapear para o formato que o
// render abaixo já espera (num/texto), sem mexer no JSX.
const passos = (site.processo ?? []).map(p => ({
  num: p.numero, titulo: p.titulo, texto: p.descricao,
}))

const faqs = site.faq ?? []
---

<Header
  logoSrc={site.logo?.src}
  logoAlt={site.logo?.alt}
  variante="padrao"
  nomeSite={site.nome}
  telefone={site.nap.telefone}
  whatsapp={site.nap.whatsapp}
  nav={site.nav}
    ctaTexto="Agendar Consulta"
    ctaHref="/contato"
  />

  {/* ── Hero split ────────────────────────────────────────────────── */}
  <section class="bg-surface-2 border-b border-line">
    <div class="container-wide grid md:grid-cols-2 gap-0 items-stretch min-h-[420px]">

      {/* Texto */}
      <div class="flex flex-col justify-center py-14 pr-0 md:pr-12">
        <nav class="mb-4 text-xs text-ink-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary no-underline transition-colors">Home</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <a href="/servicos" class="hover:text-primary no-underline transition-colors">Serviços</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <span>{entry.data.titulo}</span>
        </nav>

        {entry.data.categoria && (
          <span class="mb-3 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary w-fit">
            {entry.data.categoria}
          </span>
        )}

        <h1 class="text-[clamp(1.75rem,4vw,2.75rem)] font-bold text-secondary leading-tight mb-4">
          {entry.data.titulo}
        </h1>

        <div class="text-base text-ink-muted leading-relaxed max-w-[480px] mb-8">
          <Content />
        </div>

        <div class="flex flex-wrap gap-3">
          <a href={`https://wa.me/${site.nap.whatsapp?.replace(/\D/g,'')}`}
             target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 rounded-btn bg-primary px-5 py-2.5 text-sm font-semibold text-primary-ink no-underline hover:opacity-90 transition-opacity">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Agendar pelo WhatsApp
          </a>
          <a href="/servicos"
             class="inline-flex items-center rounded-btn border border-line px-5 py-2.5 text-sm font-semibold text-ink no-underline hover:border-primary hover:text-primary transition-colors">
            Ver todos os serviços
          </a>
        </div>
      </div>

      {/* Imagem */}
      {entry.data.imagem ? (
        <div class="hidden md:block relative overflow-hidden">
          <img src={entry.data.imagem}
               alt={entry.data.imagemAlt ?? entry.data.titulo}
               width="640" height="480"
               class="absolute inset-0 h-full w-full object-cover"
               loading="eager" />
        </div>
      ) : (
        <div class="hidden md:block bg-primary/10"></div>
      )}
    </div>
  </section>

  {/* ── Benefícios ────────────────────────────────────────────────── */}
  <section class="py-[var(--space-section)]">
    <div class="container-wide">
      <div class="max-w-[560px] mb-10">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Por que escolher a {site.nome}</p>
        <h2 class="text-[clamp(1.375rem,2.5vw,2rem)] font-bold text-secondary">
          O que você recebe em cada atendimento
        </h2>
      </div>

      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
        {beneficios.map(b => (
          <li class="flex gap-4 rounded-[var(--radius-card)] border border-line bg-surface p-5">
            <span class="text-2xl leading-none shrink-0" aria-hidden="true">{b.icone}</span>
            <div>
              <p class="font-semibold text-secondary text-sm mb-1">{b.titulo}</p>
              <p class="text-sm text-ink-muted leading-relaxed">{b.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── Como funciona ─────────────────────────────────────────────── */}
  <section class="py-[var(--space-section)] bg-surface border-y border-line">
    <div class="container-wide">
      <div class="max-w-[560px] mb-10">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Processo</p>
        <h2 class="text-[clamp(1.375rem,2.5vw,2rem)] font-bold text-secondary">
          Como funciona na prática
        </h2>
      </div>

      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 list-none p-0 m-0">
        {passos.map((p, i) => (
          <li class="relative pl-0">
            <div class="mb-4 flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-primary-ink font-bold text-sm">
                {p.num}
              </span>
              {i < passos.length - 1 && (
                <div class="hidden lg:block flex-1 h-px bg-line"></div>
              )}
            </div>
            <p class="font-semibold text-secondary text-sm mb-1">{p.titulo}</p>
            <p class="text-sm text-ink-muted leading-relaxed">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── FAQ ───────────────────────────────────────────────────────── */}
  <section class="py-[var(--space-section)] bg-surface-2">
    <div class="container-wide max-w-[760px]">
      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Dúvidas frequentes</p>
        <h2 class="text-[clamp(1.375rem,2.5vw,2rem)] font-bold text-secondary">
          Perguntas sobre {entry.data.titulo}
        </h2>
      </div>

      <dl class="divide-y divide-line">
        {faqs.map((faq, i) => (
          <div class="group">
            <input type="checkbox" id={`faq-${i}`} class="sr-only peer" />
            <label for={`faq-${i}`}
                   class="flex cursor-pointer items-start justify-between gap-4 py-5 font-semibold text-secondary text-sm hover:text-primary transition-colors">
              <span>{faq.pergunta}</span>
              <svg class="h-4 w-4 shrink-0 mt-0.5 transition-transform peer-checked:rotate-180 group-has-[input:checked]:rotate-180"
                   viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </label>
            <div class="hidden peer-checked:block pb-5">
              <p class="text-sm text-ink-muted leading-relaxed">{faq.resposta}</p>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── Depoimentos ───────────────────────────────────────────────── */}
  {depoimentos.length > 0 && (
    <section class="py-[var(--space-section)] bg-surface-2">
      <div class="container-wide">
        <div class="mb-10 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Depoimentos</p>
          <h2 class="text-[clamp(1.375rem,2.5vw,2rem)] font-bold text-secondary">
            O que nossos pacientes dizem
          </h2>
        </div>

        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
          {depoimentos.map(dep => (
            <li class="flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 gap-4">
              {/* Estrelas */}
              <div class="flex gap-0.5" aria-label={`Nota ${dep.data.nota} de 5`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M7 1l1.545 3.13L12 4.635l-2.5 2.435.59 3.44L7 8.885l-3.09 1.625L4.5 7.07 2 4.635l3.455-.505L7 1z"
                          fill={i < dep.data.nota ? 'var(--color-primary)' : 'var(--color-line)'}/>
                  </svg>
                ))}
              </div>

              {/* Texto */}
              <p class="text-sm text-ink leading-relaxed flex-1 italic">
                "{dep.body.trim()}"
              </p>

              {/* Autor */}
              <div class="border-t border-line pt-4">
                <p class="font-semibold text-secondary text-sm">{dep.data.nome}</p>
                <p class="text-xs text-ink-muted">{dep.data.cidade} · {dep.data.servico}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ── NAP ───────────────────────────────────────────────────────── */}
  <section class="py-[var(--space-section)] border-t border-line">
    <div class="container-wide grid gap-10 md:grid-cols-2 lg:grid-cols-3 items-start">

      {/* Endereço */}
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-3">Localização</p>
        <p class="font-bold text-secondary text-sm mb-1">{site.nome}</p>
        <address class="not-italic text-sm text-ink-muted leading-relaxed">
          {site.nap.logradouro}, {site.nap.complemento}<br />
          {site.nap.bairro}, {site.nap.cidade} — {site.nap.uf}<br />
          CEP {site.nap.cep}
        </address>
        <a href={`https://maps.google.com/?q=${encodeURIComponent(site.nap.enderecoFormatado)}`}
           target="_blank" rel="noopener noreferrer"
           class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-primary no-underline hover:underline">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="10" r="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Ver no Google Maps
        </a>
      </div>

      {/* Contato */}
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-3">Contato</p>
        <ul class="list-none p-0 m-0 space-y-2 text-sm text-ink-muted">
          <li>
            <a href={`tel:${site.nap.telefone.replace(/\D/g,'')}`}
               class="flex items-center gap-2 no-underline hover:text-primary transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.05a16 16 0 006.86 6.86l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {site.nap.telefone}
            </a>
          </li>
          <li>
            <a href={`https://wa.me/${site.nap.whatsapp}`}
               target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 no-underline hover:text-primary transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </li>
          <li>
            <a href={`mailto:${site.nap.email}`}
               class="flex items-center gap-2 no-underline hover:text-primary transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 6l-10 7L2 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {site.nap.email}
            </a>
          </li>
        </ul>
      </div>

      {/* Horários */}
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-3">Horários de atendimento</p>
        <ul class="list-none p-0 m-0 space-y-2">
          {site.horarios.map(h => (
            <li class="flex justify-between text-sm border-b border-line/40 pb-2 last:border-0">
              <span class="text-ink-muted">{h.dia}</span>
              <span class="font-semibold text-secondary">{h.hora}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Cta
    variante="padrao"
    titulo="Pronto para agendar sua consulta?"
    descricao="Nossa equipe está disponível de segunda a sábado. Resposta via WhatsApp em até 2 horas."
    ctaPrimTexto="Agendar pelo WhatsApp"
    ctaPrimHref={`https://wa.me/${site.nap.whatsapp?.replace(/\D/g,'')}`}
    ctaSecTexto="Outros serviços"
    ctaSecHref="/servicos"
  />

  <Footer
    logoSrc={site.logo?.src}
    logoAlt={site.logo?.alt}
    credencial={textoCredencial(site)}
    variante="escuro"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
