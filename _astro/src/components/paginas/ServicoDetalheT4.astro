---
/**
 * Página de serviço do Tema 04 — a página que mais vende neste modelo.
 *
 * Ordem pensada para o visitante que chegou de busca com um problema:
 *   promessa → prova visual → o que resolve → como funciona (processo) →
 *   quanto custa e quanto demora → prova social → dúvidas → onde atendemos.
 *
 * Composição obrigatória do tema: Depoimentos + NAP + mapa embedado.
 */
import Tema04Base   from '../../layouts/Tema04Base.astro'
import Header       from '../../components/blocos/Header.astro'
import PageHero     from '../../components/blocos/PageHero.astro'
import AntesDepois  from '../../components/blocos/AntesDepois.astro'
import Passos       from '../../components/blocos/Passos.astro'
import Servicos     from '../../components/blocos/Servicos.astro'
import Depoimentos  from '../../components/blocos/Depoimentos.astro'
import Faq          from '../../components/blocos/Faq.astro'
import Localizacao  from '../../components/blocos/Localizacao.astro'
import Cta          from '../../components/blocos/Cta.astro'
import Footer       from '../../components/blocos/Footer.astro'
import { site }     from '../../config/tema-04.ts'
import { textoCredencial, areaServida } from '../../lib/schema.ts'
import { getCollection, render } from 'astro:content'

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'servicosT4'>>>[number]
}

const { entry }   = Astro.props
const { Content } = await render(entry)
const canonical   = `${site.dominio}/${entry.id}/`
const wa          = `https://wa.me/${site.nap.whatsapp}`

const outros = (await getCollection('servicosT4'))
  .filter(s => s.id !== entry.id)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(s => ({
    titulo: s.data.titulo, descricao: s.data.resumo, icone: s.data.icone ?? '',
    imagem: s.data.imagem, imagemAlt: s.data.imagemAlt,
    href: `/tema-04/${s.id}`, categoria: s.data.categoria,
  }))

const depoimentos = (await getCollection('depoimentosT4'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(d => ({ nome: d.data.nome, cidade: d.data.cidade, servico: d.data.servico, corpo: (d.body ?? '').trim() }))

const ficha = [
  entry.data.precoDe  && { rotulo: 'A partir de',  valor: entry.data.precoDe },
  entry.data.duracao  && { rotulo: 'Duração',      valor: entry.data.duracao },
  entry.data.prazo    && { rotulo: 'Agendamento',  valor: entry.data.prazo },
  { rotulo: 'Garantia', valor: '90 dias' },
].filter(Boolean) as { rotulo: string; valor: string }[]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service', '@id': `${canonical}#service`,
      name: entry.data.titulo, description: entry.data.metaDescription,
      serviceType: entry.data.categoria,
      provider: { '@id': `${site.dominio}/#organization` },
      areaServed: areaServida(site),
      ...(entry.data.precoDe ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'BRL',
          priceSpecification: {
            '@type': 'PriceSpecification',
            minPrice: entry.data.precoDe.replace(/[^\d]/g, ''),
            priceCurrency: 'BRL',
          },
        },
      } : {}),
    },
    {
      '@type': 'WebPage', '@id': `${canonical}#webpage`,
      url: canonical, name: `${entry.data.titulo} — ${site.nome}`, inLanguage: 'pt-BR',
    },
    {
      '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',     item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'Serviços', item: `${site.dominio}/servicos` },
        { '@type': 'ListItem', position: 3, name: entry.data.titulo, item: canonical },
      ],
    },
    {
      '@type': 'FAQPage', '@id': `${canonical}#faq`,
      mainEntity: site.faq.map(f => ({
        '@type': 'Question', name: f.pergunta,
        acceptedAnswer: { '@type': 'Answer', text: f.resposta },
      })),
    },
  ],
}
---

<Tema04Base
  titulo={`${entry.data.titulo} em ${site.nap.cidade} — ${site.nome}`}
  metaDescription={entry.data.metaDescription}
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="servico"
  noindex={entry.data.noindex ?? false}
>
  <Header logoSrc={site.logo?.src} logoAlt={site.logo?.alt}
    variante="padrao"
    nomeSite={site.nome}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Peça seu orçamento"
    ctaHref={wa}
  />

  <PageHero
    variante="destaque"
    eyebrow={entry.data.categoria}
    titulo={`${entry.data.titulo} em ${site.nap.cidade}`}
    descricao={entry.data.resumo}
  />

  {/* Foto grande + ficha rápida + ação */}
  <section class="py-[var(--space-section)]">
    <div class="container-wide">
      <nav class="mb-6 text-xs text-ink-muted" aria-label="Breadcrumb">
        <a href="/tema-04" class="no-underline hover:text-primary">Home</a>
        <span class="mx-1.5 text-ink-muted/50">›</span>
        <a href="/tema-04/servicos" class="no-underline hover:text-primary">Serviços</a>
        <span class="mx-1.5 text-ink-muted/50">›</span>
        <span>{entry.data.titulo}</span>
      </nav>

      {entry.data.imagem && (
        <div class="overflow-hidden rounded-[var(--radius-card)]">
          <img src={entry.data.imagem} alt={entry.data.imagemAlt ?? entry.data.titulo}
               width="1200" height="520" class="max-h-[420px] w-full object-cover" loading="eager" />
        </div>
      )}

      <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {ficha.map(f => (
          <div class="rounded-[var(--radius-card)] border border-line bg-surface-2 p-5">
            <dt class="text-xs font-semibold uppercase tracking-wider text-primary">{f.rotulo}</dt>
            <dd class="m-0 mt-1.5 font-display text-lg font-bold text-secondary">{f.valor}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-6 text-center">
        <a href={wa} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2.5 rounded-[var(--radius-pill)] bg-success px-8 py-3.5 text-sm font-bold uppercase tracking-wide text-white no-underline transition-opacity hover:opacity-90">
          Pedir orçamento no WhatsApp
        </a>
      </div>
    </div>
  </section>

  {/* Prova visual antes do texto — é o que o visitante quer ver primeiro */}
  <AntesDepois
    titulo="O resultado deste serviço"
    descricao="Peças reais atendidas pela equipe, sem retoque."
    itens={site.antesDepois}
    ctaTexto="Quero esse resultado"
    ctaHref={wa}
  />

  {/* Texto do serviço + o que remove */}
  <section class="py-[var(--space-section)]">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_340px] lg:items-start">
      <div class="article-body">
        <Content />
      </div>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-6">
        {entry.data.remove.length > 0 && (
          <div class="rounded-[var(--radius-card)] border border-line bg-surface-2 p-6">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-primary">O que este serviço remove</p>
            <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
              {entry.data.remove.map(r => (
                <li class="flex gap-2.5 text-sm leading-snug text-ink">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="2.5" class="mt-0.5 shrink-0 text-success" aria-hidden="true">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {entry.data.entregas.length > 0 && (
          <div class="rounded-[var(--radius-card)] border border-line bg-surface p-6">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-primary">Está incluído</p>
            <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
              {entry.data.entregas.map(e => (
                <li class="flex gap-2.5 text-sm leading-snug text-ink">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="rounded-[var(--radius-card)] bg-secondary p-6 text-surface">
          <p class="font-display text-base font-bold leading-snug">Orçamento pela foto</p>
          <p class="mt-2 text-sm leading-relaxed text-surface/75">
            Manda uma foto da peça no WhatsApp. Devolvemos o valor fechado e a primeira data livre.
          </p>
          <a href={wa} target="_blank" rel="noopener noreferrer"
             class="mt-4 inline-block rounded-[var(--radius-pill)] bg-success px-6 py-2.5 text-sm font-bold text-white no-underline transition-opacity hover:opacity-90">
            Enviar foto
          </a>
        </div>
      </aside>
    </div>
  </section>

  {/* Como funciona */}
  <Passos
    variante="numerado"
    titulo={`Como fazemos a ${entry.data.titulo.toLowerCase()}`}
    descricao="Processo fixo, feito por equipe própria e sempre na mesma ordem."
    itens={site.processo}
    notaTitulo="Tempo de secagem: de 8 a 12 horas"
    nota="O prazo varia conforme o tecido, o clima e a ventilação do ambiente. Ventilador apontado para a peça e janela aberta encurtam bastante. Secador e sol direto ressecam a fibra — não recomendamos."
  />

  <Servicos
    variante="grade"
    titulo="Outros serviços"
    itens={outros}
  />

  <Depoimentos
    titulo="Quem já contratou este serviço"
    itens={depoimentos}
    notaMedia={site.avaliacao.nota}
    totalAvaliacoes={site.avaliacao.total}
    fonteAvaliacoes={site.avaliacao.fonte}
  />

  <Faq
    variante="com-imagem"
    titulo={`Dúvidas sobre ${entry.data.titulo.toLowerCase()}`}
    descricao="As perguntas que mais chegam antes de fechar o serviço."
    itens={site.faq}
    imagem="https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?w=400&h=520&fit=crop&auto=format"
    imagemAlt="Técnico higienizando um estofado em domicílio"
  />

  <Localizacao
    titulo="Onde estamos"
    descricao="Base em Campinas, atendimento em domicílio em toda a região metropolitana."
    logradouro={site.nap.logradouro}
    complemento={site.nap.complemento}
    bairro={site.nap.bairro}
    cidade={site.nap.cidade}
    uf={site.nap.uf}
    cep={site.nap.cep}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    email={site.nap.email}
    horarios={site.horarios}
    mapaSrc={site.mapaSrc}
    mapaHref={`https://maps.google.com/?q=${encodeURIComponent(site.nap.enderecoFormatado)}`}
  />

  <Cta
    variante="padrao"
    titulo={`Quer um valor para ${entry.data.titulo.toLowerCase()}?`}
    descricao="Preço fechado antes de começar, sem taxa de visita dentro de Campinas."
    ctaPrimTexto="Pedir orçamento"
    ctaPrimHref={wa}
    ctaSecTexto="Ver todos os serviços"
    ctaSecHref="/tema-04/servicos"
  />

  <Footer credencial={textoCredencial(site)} logoSrc={site.logo?.src} logoAlt={site.logo?.alt}
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema04Base>
