---
/**
 * Página de benefício do Tema 05 (componente da rota unificada [slug].astro) — a estrutura da referência:
 *   hero escuro com destaques → entenda o benefício → quem pode solicitar →
 *   situações que geram direito → passo a passo → dúvidas → CTA
 *
 * Acrescentados a pedido, e que a referência não tinha:
 *   Depoimentos e NAP completo com mapa embedado.
 */
import Tema05Base   from '../../layouts/Tema05Base.astro'
import Header       from '../../components/blocos/Header.astro'
import Hero         from '../../components/blocos/Hero.astro'
import Servicos     from '../../components/blocos/Servicos.astro'
import Prova        from '../../components/blocos/Prova.astro'
import Passos       from '../../components/blocos/Passos.astro'
import Depoimentos  from '../../components/blocos/Depoimentos.astro'
import Faq          from '../../components/blocos/Faq.astro'
import Localizacao  from '../../components/blocos/Localizacao.astro'
import Cta          from '../../components/blocos/Cta.astro'
import Footer       from '../../components/blocos/Footer.astro'
import { site }     from '../../config/tema-05.ts'
import { textoCredencial, areaServida, rotuloNav } from '../../lib/schema.ts'
import { getCollection, render } from 'astro:content'
import { ehServicoListavel } from '../../lib/publicacao.ts'

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'servicosT5'>>>[number]
}

const { entry }   = Astro.props
const { Content } = await render(entry)
const canonical   = `${site.dominio}/${entry.id}/`

const outros = (await getCollection('servicosT5', ehServicoListavel))
  .filter(s => s.id !== entry.id)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(s => ({
    titulo: s.data.titulo, descricao: s.data.resumo, icone: s.data.icone ?? '',
    imagem: s.data.imagem, imagemAlt: s.data.imagemAlt,
    href: `/tema-05/${s.id}`, categoria: s.data.categoria,
  }))

const depoimentos = (await getCollection('depoimentosT5'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(d => ({ nome: d.data.nome, cidade: d.data.cidade, servico: d.data.servico, corpo: (d.body ?? '').trim() }))

/* "Quem pode solicitar" reaproveita o bloco Servicos: mesma forma de card
   com imagem, título e descrição. Sem href, os cards não viram link. */
const perfis = entry.data.quemPode.map(q => ({
  titulo: q.titulo, descricao: q.descricao,
  imagem: q.imagem, imagemAlt: q.imagemAlt,
}))

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service', '@id': `${canonical}#service`,
      name: entry.data.titulo, description: entry.data.metaDescription,
      serviceType: entry.data.categoria,
      provider: { '@id': `${site.dominio}/#organization` },
      areaServed: areaServida(site),
    },
    {
      '@type': 'WebPage', '@id': `${canonical}#webpage`,
      url: canonical, name: `${entry.data.titulo} — ${site.nome}`, inLanguage: 'pt-BR',
    },
    {
      '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',    item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: rotuloNav(site, '/servicos', 'Atuação'), item: `${site.dominio}/servicos` },
        { '@type': 'ListItem', position: 3, name: entry.data.titulo, item: canonical },
      ],
    },
    {
      '@type': 'FAQPage', '@id': `${canonical}#faq`,
      mainEntity: site.faq.map(f => ({
        '@type': 'Question', name: f.pergunta,
        acceptedAnswer: { '@type': 'Answer', text: f.resposta },
      })),
    },
  ],
}
---

<Tema05Base
  titulo={`${entry.data.titulo} — Advogado em ${site.nap.cidade}`}
  metaDescription={entry.data.metaDescription}
  canonical={canonical}
  jsonLd={jsonLd}
  nodeId="servico"
  noindex={entry.data.noindex ?? false}
>
  <Header logoSrc={site.logo?.src} logoAlt={site.logo?.alt}
    variante="padrao"
    nomeSite={site.nome}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    nav={site.nav}
    ctaTexto="Agendar atendimento"
    ctaHref="/tema-05/contato"
  />

  {/* Hero escuro com imagem e destaques do benefício */}
  <Hero
    variante="destaque"
    eyebrow={entry.data.categoria}
    titulo={entry.data.titulo}
    lead={entry.data.resumo}
    ctaPrimTexto="Falar com um advogado"
    ctaPrimHref="/tema-05/contato"
    ctaSecTexto="Ver todas as áreas"
    ctaSecHref="/tema-05/servicos"
    imagem={entry.data.imagem}
    imagemAlt={entry.data.imagemAlt}
  />

  {/* Faixa de destaques do benefício */}
  {entry.data.destaques.length > 0 && (
    <section class="border-b border-line bg-surface-2 py-8">
      <div class="container-wide">
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-3">
          {entry.data.destaques.map(d => (
            <li class="flex gap-3 text-sm leading-snug text-ink">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Entenda este benefício */}
  <section class="py-[var(--space-section)]">
    <div class="container-wide grid gap-12 lg:grid-cols-[1fr_400px] lg:items-start">
      <div class="article-body">
        <nav class="mb-6 text-xs text-ink-muted" aria-label="Breadcrumb">
          <a href="/tema-05" class="no-underline hover:text-primary">Home</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <a href="/tema-05/servicos" class="no-underline hover:text-primary">{rotuloNav(site, '/servicos', 'Atuação')}</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <span>{entry.data.titulo}</span>
        </nav>
        <Content />
      </div>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-6">
        {entry.data.imagem && (
          <div class="overflow-hidden rounded-[var(--radius-card)] border border-line">
            <img src={entry.data.imagem} alt={entry.data.imagemAlt ?? entry.data.titulo}
                 width="400" height="300" class="w-full object-cover" loading="lazy" />
          </div>
        )}

        <div class="rounded-[var(--radius-card)] bg-secondary p-6 text-surface">
          <p class="font-display text-base font-bold leading-snug">Não sabe se o seu caso se enquadra?</p>
          <p class="mt-2 text-sm leading-relaxed text-surface/75">
            A conversa inicial serve para isso: entender a sua história de contribuição e dizer o que
            o caso comporta — inclusive quando a resposta é que não há fundamento.
          </p>
          <a href="/tema-05/contato"
             class="mt-4 inline-block rounded-[var(--radius-btn)] bg-accent px-5 py-2.5 text-sm font-semibold text-secondary no-underline transition-opacity hover:opacity-90">
            Agendar conversa
          </a>
          <p class="mt-3 text-xs text-surface/50">
            Honorários pela tabela da OAB/MG, definidos em contrato antes de qualquer providência.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {/* Quem pode solicitar */}
  {perfis.length > 0 && (
    <Servicos
      variante="grade"
      titulo="Perfis que costumam se enquadrar"
      descricao="Situações em que o benefício costuma ser cabível. A análise do caso concreto é sempre individual."
      itens={perfis}
    />
  )}

  {/* Pontos que mudam a análise do caso */}
  {entry.data.situacoes.length > 0 && (
    <Prova
      titulo="Pontos que mudam a análise do caso"
      descricao="Detalhes que aparecem com frequência e que costumam decidir o rumo do pedido."
      itens={entry.data.situacoes}
    />
  )}

  {/* Como funciona, passo a passo */}
  <Passos
    variante="numerado"
    titulo="Como conduzimos o caso"
    descricao="Seis etapas, na mesma ordem, do primeiro contato até a decisão final."
    itens={site.passos}
    notaTitulo="Sobre prazos"
    nota="Não damos previsão fechada de duração porque ela não depende do escritório — depende da fila do INSS e, no caso judicial, da vara. O que garantimos é o relatório mensal do andamento, sem você precisar cobrar."
  />

  {/* Acrescentado ao layout da referência: prova social */}
  <Depoimentos
    titulo="Relatos de quem já foi atendido"
    itens={depoimentos}
    notaMedia="4,9"
    totalAvaliacoes="+140"
    fonteAvaliacoes="avaliações no Google"
  />

  <Faq
    variante="com-imagem"
    titulo={`Dúvidas sobre ${entry.data.titulo}`}
    descricao="As perguntas que mais aparecem na primeira conversa."
    itens={site.faq}
    imagem="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=400&h=520&fit=crop&auto=format"
    imagemAlt="Advogado em atendimento a cliente"
  />

  {/* Acrescentado ao layout da referência: NAP completo com mapa */}
  <Localizacao
    titulo="Onde estamos"
    descricao="Atendimento presencial com hora marcada em Belo Horizonte e por videoconferência para outras cidades."
    logradouro={site.nap.logradouro}
    complemento={site.nap.complemento}
    bairro={site.nap.bairro}
    cidade={site.nap.cidade}
    uf={site.nap.uf}
    cep={site.nap.cep}
    telefone={site.nap.telefone}
    whatsapp={site.nap.whatsapp}
    email={site.nap.email}
    horarios={site.horarios}
    mapaSrc={site.mapaSrc}
    mapaHref={`https://maps.google.com/?q=${encodeURIComponent(site.nap.enderecoFormatado)}`}
  />

  <Servicos
    variante="lista"
    titulo="Outras áreas de atuação"
    itens={outros}
  />

  <Cta
    variante="padrao"
    titulo={`Quer saber se você se enquadra em ${entry.data.titulo}?`}
    descricao="Agende uma conversa. Analisamos a documentação e damos um parecer honesto sobre o que o caso comporta."
    ctaPrimTexto="Agendar atendimento"
    ctaPrimHref="/tema-05/contato"
    ctaSecTexto="Entender o processo"
    ctaSecHref="/tema-05/direito-previdenciario"
  />

  <Footer credencial={textoCredencial(site)} logoSrc={site.logo?.src} logoAlt={site.logo?.alt}
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema05Base>
