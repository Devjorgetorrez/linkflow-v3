---
/**
 * Artigo do Tema 05 (componente da rota unificada [slug].astro).
 * Autor e categoria resolvidos pelos perfis em content/tema-05/autores e
 * content/tema-05/categorias (lib/autores.ts e lib/categorias.ts).
 */
import Tema05Base  from '../../layouts/Tema05Base.astro'
import Header      from '../../components/blocos/Header.astro'
import Autor       from '../../components/blocos/Autor.astro'
import PostLista   from '../../components/blocos/PostLista.astro'
import Cta         from '../../components/blocos/Cta.astro'
import Footer      from '../../components/blocos/Footer.astro'
import { site }    from '../../config/tema-05.ts'
import { textoCredencial } from '../../lib/schema.ts'
import { seoDoPost, faqJsonLd } from '../../lib/post-seo.ts'
import PostFaq from '../blocos/PostFaq.astro'
import { getCollection, render } from 'astro:content'
import { ehPublicado } from '../../lib/publicacao.ts'
import { resolverAutor, nomeAutor } from '../../lib/autores.ts'
import { resolverCategoria, nomeCategoria } from '../../lib/categorias.ts'

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'postsT5'>>>[number]
}

const { entry }   = Astro.props
const { Content } = await render(entry)
const canonical   = `${site.dominio}/${entry.id}`
const seo         = seoDoPost(entry.data, site.nome, canonical)
const faqNode     = faqJsonLd(seo.faq, canonical)

const dataFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date(entry.data.publicadoEm + 'T12:00:00'))

// Autor: perfil em content/autores (slug em `autor:`), com link /autor/<slug>
const autores = await getCollection('autoresT5')
const autor   = resolverAutor(entry.data, autores, '/tema-05')
const autorJsonLd = autor
  ? {
      '@type': 'Person',
      ...(autor.href ? { '@id': `${site.dominio}${autor.href}#person`, url: `${site.dominio}${autor.href}` } : {}),
      name: autor.nome,
      ...(autor.cargo ? { jobTitle: autor.cargo } : {}),
      ...(autor.foto ? { image: autor.foto } : {}),
      worksFor: { '@id': `${site.dominio}/#organization` },
      ...(autor.sameAs.length ? { sameAs: autor.sameAs } : {}),
    }
  : undefined

// Categoria: perfil em content/categorias (slug em `categoria:`), com link /<slug>
const categorias = await getCollection('categoriasT5')
const categoria  = resolverCategoria(entry.data.categoria, categorias, '/tema-05')

const relacionados = (await getCollection('postsT5', ehPublicado))
  .filter(p => p.id !== entry.id)
  .sort((a, b) => new Date(b.data.publicadoEm).getTime() - new Date(a.data.publicadoEm).getTime())
  .map(p => ({
    titulo: p.data.titulo, publicadoEm: p.data.publicadoEm,
    categoria: nomeCategoria(p.data.categoria, categorias),
    imagemCapa: p.data.imagemCapa, imagemCapaAlt: p.data.imagemCapaAlt, resumo: p.data.resumo,
    autor: nomeAutor(p.data, autores), href: `/tema-05/${p.id}`,
  }))

const shareUrl  = encodeURIComponent(canonical)
const shareText = encodeURIComponent(entry.data.titulo)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(faqNode ? [faqNode] : []),
    {
      '@type': 'BlogPosting', '@id': `${canonical}#article`,
      headline: entry.data.titulo, description: seo.metaDescription,
      datePublished: entry.data.publicadoEm, dateModified: entry.data.publicadoEm,
      inLanguage: 'pt-BR', image: entry.data.imagemCapa, articleSection: categoria?.nome,
      ...(autorJsonLd ? { author: autorJsonLd } : {}),
      publisher: { '@id': `${site.dominio}/#organization` },
      mainEntityOfPage: { '@id': `${canonical}#webpage` },
    },
    {
      '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',        item: `${site.dominio}/` },
        { '@type': 'ListItem', position: 2, name: 'Publicações', item: `${site.dominio}/blog` },
        { '@type': 'ListItem', position: 3, name: entry.data.titulo, item: canonical },
      ],
    },
  ],
}
---

<Tema05Base
  titulo={seo.titulo}
  metaDescription={seo.metaDescription}
  canonical={seo.canonical}
  noindex={seo.noindex}
  jsonLd={jsonLd}
  nodeId="post"
>
  <Header logoSrc={site.logo?.src} logoAlt={site.logo?.alt} variante="padrao" nomeSite={site.nome} telefone={site.nap.telefone}
          whatsapp={site.nap.whatsapp} nav={site.nav}
          ctaTexto="Agendar atendimento" ctaHref="/tema-05/contato" />

  <article>
    <div class="border-b border-line bg-surface-2 py-12">
      <div class="container-wide max-w-[760px]">
        <nav class="mb-5 text-xs text-ink-muted" aria-label="Breadcrumb">
          <a href="/tema-05" class="no-underline transition-colors hover:text-primary">Home</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <a href="/tema-05/blog" class="no-underline transition-colors hover:text-primary">Publicações</a>
          <span class="mx-1.5 text-ink-muted/50">›</span>
          <span>{entry.data.titulo}</span>
        </nav>

        {categoria && (
          categoria.href
            ? (
              <a href={categoria.href}
                 class="mb-3 inline-block rounded-[var(--radius-btn)] bg-primary/10 px-3 py-1 text-xs font-semibold text-primary no-underline hover:bg-primary/15">
                {categoria.nome}
              </a>
            )
            : (
              <span class="mb-3 inline-block rounded-[var(--radius-btn)] bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                {categoria.nome}
              </span>
            )
        )}

        <h1 class="mb-6 font-display text-[clamp(1.625rem,4vw,2.5rem)] font-bold leading-tight text-secondary">
          {entry.data.titulo}
        </h1>

        <Autor
          variante="byline"
          nome={autor?.nome ?? ""}
          foto={autor?.foto}
          cargo={autor?.cargo}
          href={autor?.href}
          data={dataFormatada}
        />
      </div>
    </div>

    {entry.data.imagemCapa && (
      <div class="container-wide max-w-[760px] pt-10">
        <div class="overflow-hidden rounded-[var(--radius-card)]">
          <img src={entry.data.imagemCapa}
               alt={entry.data.imagemCapaAlt ?? ''}
               width="760" height="420" class="max-h-[420px] w-full object-cover" loading="eager" />
        </div>
      </div>
    )}

    <div class="container-wide max-w-[760px] py-12">
      <div class="article-body"><Content /></div>

      <PostFaq faq={seo.faq} />

      <p class="mt-10 rounded-[var(--radius-card)] border-l-4 border-accent bg-surface-2 p-5 text-sm leading-relaxed text-ink-muted">
        Este texto tem finalidade informativa e não constitui parecer jurídico sobre caso concreto.
        Cada situação previdenciária depende de documentação e histórico próprios.
      </p>

      <div class="mt-8 border-t border-line pt-8">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-muted">Compartilhar</p>
        <div class="flex flex-wrap gap-2">
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer"
             class="rounded-[var(--radius-btn)] border border-line px-4 py-2 text-xs font-semibold text-ink no-underline transition-colors hover:border-primary hover:text-primary">LinkedIn</a>
          <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener noreferrer"
             class="rounded-[var(--radius-btn)] border border-line px-4 py-2 text-xs font-semibold text-ink no-underline transition-colors hover:border-primary hover:text-primary">WhatsApp</a>
          <a href={`mailto:?subject=${shareText}&body=${shareUrl}`}
             class="rounded-[var(--radius-btn)] border border-line px-4 py-2 text-xs font-semibold text-ink no-underline transition-colors hover:border-primary hover:text-primary">E-mail</a>
        </div>
      </div>

      <Autor
        variante="assinatura"
        nome={autor?.nome ?? ""}
        foto={autor?.foto}
        cargo={autor?.cargo}
        credencial={autor?.credencial}
        bio={autor?.bio}
        linkedin={autor?.linkedin}
        instagram={autor?.instagram}
        email={autor?.email}
        href={autor?.href}
      />
    </div>
  </article>

  <PostLista variante="grade" titulo="Outras publicações" posts={relacionados} verMaisHref="/tema-05/blog" />

  <Cta
    variante="padrao"
    titulo="Quer saber como isso se aplica ao seu caso?"
    descricao="O texto explica a regra geral. A aplicação depende do seu histórico de contribuição e da documentação disponível."
    ctaPrimTexto="Agendar atendimento"
    ctaPrimHref="/tema-05/contato"
    ctaSecTexto="Ver áreas de atuação"
    ctaSecHref="/tema-05/servicos"
  />

  <Footer credencial={textoCredencial(site)} logoSrc={site.logo?.src} logoAlt={site.logo?.alt}
    variante="colunas"
    nomeSite={site.nome}
    slogan={site.slogan}
    telefone={site.nap.telefone}
    email={site.nap.email}
    endereco={`${site.nap.logradouro}, ${site.nap.complemento}`}
    cidade={`${site.nap.bairro}, ${site.nap.cidade} — ${site.nap.uf}`}
    cnpj={site.cnpj}
    anoFundacao={site.anoFundacao}
    redes={site.redes}
    nav={site.nav}
    colunas={site.navFooterColunas}
  />
</Tema05Base>
