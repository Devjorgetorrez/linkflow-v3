---
/**
 * Cta — variantes: padrao | card
 * Empty state: não renderiza sem titulo.
 */

interface Props {
  variante?:     'padrao' | 'card'
  titulo?:       string
  descricao?:    string
  ctaPrimTexto?: string
  ctaPrimHref?:  string
  ctaSecTexto?:  string
  ctaSecHref?:   string
  nota?:         string
}

const {
  variante     = 'padrao',
  titulo,
  descricao,
  ctaPrimTexto,
  ctaPrimHref  = '#',
  ctaSecTexto,
  ctaSecHref   = '#',
  nota,
} = Astro.props

if (!titulo) return
---

{variante === 'padrao' && (
  <section class="bg-secondary py-[var(--space-section)]">
    <div class="container-wide text-center">
      <h2 class="text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-primary-ink mx-auto max-w-[640px]">
        {titulo}
      </h2>
      {descricao && (
        <p class="mt-3 text-base text-primary-ink/75 max-w-[520px] mx-auto">{descricao}</p>
      )}
      {(ctaPrimTexto || ctaSecTexto) && (
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {ctaPrimTexto && (
            <a href={ctaPrimHref}
               class="rounded-[var(--radius-btn)] bg-accent px-7 py-3.5 text-sm font-bold text-secondary no-underline transition-opacity hover:opacity-90">
              {ctaPrimTexto}
            </a>
          )}
          {ctaSecTexto && (
            <a href={ctaSecHref}
               class="rounded-[var(--radius-btn)] border border-primary-ink/30 px-7 py-3.5 text-sm font-medium text-primary-ink no-underline transition-colors hover:border-primary-ink/70">
              {ctaSecTexto}
            </a>
          )}
        </div>
      )}
      {nota && <p class="mt-4 text-xs text-primary-ink/55">{nota}</p>}
    </div>
  </section>
)}

{variante === 'card' && (
  <section class="py-[var(--space-section)] bg-surface">
    <div class="container-wide max-w-[860px]">
      <div class="rounded-[var(--radius-card)] bg-surface-2 border border-line p-10 text-center">
        <h2 class="text-[clamp(1.5rem,2.5vw,2rem)] font-bold text-secondary">{titulo}</h2>
        {descricao && (
          <p class="mt-3 text-base text-ink-muted max-w-[480px] mx-auto">{descricao}</p>
        )}
        {(ctaPrimTexto || ctaSecTexto) && (
          <div class="mt-7 flex flex-wrap justify-center gap-3">
            {ctaPrimTexto && (
              <a href={ctaPrimHref}
                 class="rounded-[var(--radius-btn)] bg-primary px-7 py-3 text-sm font-semibold text-primary-ink no-underline transition-opacity hover:opacity-90">
                {ctaPrimTexto}
              </a>
            )}
            {ctaSecTexto && (
              <a href={ctaSecHref}
                 class="rounded-[var(--radius-btn)] border border-line px-7 py-3 text-sm font-medium text-ink no-underline transition-colors hover:border-primary hover:text-primary">
                {ctaSecTexto}
              </a>
            )}
          </div>
        )}
        {nota && <p class="mt-4 text-xs text-ink-muted">{nota}</p>}
      </div>
    </div>
  </section>
)}
