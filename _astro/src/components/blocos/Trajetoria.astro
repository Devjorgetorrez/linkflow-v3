---
/**
 * Trajetoria — linha do tempo vertical centrada (alternado esquerda/direita em desktop)
 */

interface Marco {
  ano:    string
  titulo: string
  corpo:  string
  atual?: boolean
}

interface Props {
  titulo?:    string
  descricao?: string
  marcos:     Marco[]
}

const { titulo, descricao, marcos = [] } = Astro.props
if (marcos.length === 0) return
---

<section class="bg-surface py-[var(--space-section)]">
  <div class="container-wide max-w-[860px]">
    {(titulo || descricao) && (
      <div class="mb-12 text-center">
        {titulo && <h2 class="text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-secondary">{titulo}</h2>}
        {descricao && <p class="mt-2 text-base text-ink-muted max-w-[560px] mx-auto">{descricao}</p>}
      </div>
    )}

    <div class="relative">
      {/* Linha vertical central */}
      <div class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 bg-line hidden md:block" aria-hidden="true" />

      <ol class="list-none p-0 m-0 space-y-10 md:space-y-0">
        {marcos.map((marco, i) => {
          const esquerda = i % 2 === 0
          return (
            <li class="relative md:grid md:grid-cols-2 md:gap-0 md:pb-12 last:pb-0">
              {/* Ponto na linha */}
              <div class="absolute left-1/2 top-6 -translate-x-1/2 hidden md:flex h-4 w-4 items-center justify-center rounded-full border-2 border-primary bg-surface z-10" aria-hidden="true" />

              {/* Conteúdo — alterna lado */}
              <div class:list={[
                'rounded-[var(--radius-card)] border border-line bg-surface-2 p-6',
                esquerda ? 'md:col-start-1 md:mr-8 md:text-right' : 'md:col-start-2 md:ml-8',
              ]}>
                <p class:list={['text-sm font-bold mb-1', marco.atual ? 'text-accent' : 'text-primary']}>
                  {marco.ano}
                </p>
                <h3 class="text-base font-bold text-secondary mb-2">{marco.titulo}</h3>
                <p class="text-sm text-ink-muted leading-relaxed">{marco.corpo}</p>
              </div>

              {/* Coluna vazia para o lado oposto */}
              {esquerda
                ? <div class="hidden md:block md:col-start-2" />
                : <div class="hidden md:block md:col-start-1" />
              }
            </li>
          )
        })}
      </ol>
    </div>
  </div>
</section>
