---
/**
 * Footer — variantes: padrao | minimal | colunas
 *
 * Campos: todos do store (marca.* + negocio.* + redes). Nenhum campo de editor.
 *
 * padrao:  Logo + nav + redes + endereço + horários + legal
 * minimal: Logo + nav + copyright apenas
 * colunas: 3-4 colunas categorizadas (nav linhas separadas) + endereço + legal
 *
 * Empty state: nomeSite fallback "Empresa"; logo ausente → texto.
 * colunas: colunas sem itens são omitidas.
 * Affiliate disclosure (isBlog) → descartado para SiteFlow negócio local.
 */

interface NavItem    { label: string; href: string }
interface NavColuna  { titulo: string; itens: NavItem[] }
interface RedeItem   { nome: string; href: string }

interface Props {
  variante?:    'padrao' | 'minimal' | 'colunas' | 'escuro'
  nomeSite?:    string
  slogan?:      string
  logoSrc?:     string
  logoAlt?:     string
  telefone?:    string
  email?:       string
  endereco?:    string
  cidade?:      string
  cnpj?:        string
  credencial?:  string
  redes?:       RedeItem[]
  nav?:         NavItem[]
  colunas?:     NavColuna[]
  anoFundacao?: number
}

const {
  variante    = 'padrao',
  nomeSite    = 'Empresa',
  slogan,
  logoSrc,
  logoAlt     = nomeSite,
  telefone,
  email,
  endereco,
  cidade,
  cnpj,
  credencial,
  redes       = [],
  nav         = [],
  colunas     = [],
  anoFundacao,
} = Astro.props

/* Ícones SVG para redes sociais (inline, sem lib) */
const redesIcons: Record<string, string> = {
  Facebook:  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>',
  Instagram: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>',
  YouTube:   '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>',
  TikTok:    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.54V6.79a4.85 4.85 0 01-1.02-.1z"/></svg>',
  Threads:   '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z"/></svg>',
  X:         '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  LinkedIn:  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
}

const anoAtual = new Date().getFullYear()
---

{/* ── padrao ─────────────────────────────────────────────────────── */}
{variante === 'padrao' && (
  <footer class="border-t border-line bg-surface-2">
    <div class="container-wide py-12">
      <div class="grid gap-10 md:grid-cols-[auto_1fr_auto]">

        {/* Coluna 1: marca */}
        <div class="max-w-[200px]">
          <a href="/" class="no-underline" aria-label={`Início — ${nomeSite}`}>
            {logoSrc
              ? <img src={logoSrc} alt={logoAlt} width="140" height="32" class="h-8 w-auto mb-3" loading="lazy" />
              : <span class="font-display text-lg font-semibold text-primary">{nomeSite}</span>
            }
          </a>
          {(endereco || cidade) && (
            <address class="not-italic mt-3 text-xs text-ink-muted leading-relaxed">
              {endereco && <span class="block">{endereco}</span>}
              {cidade && <span class="block">{cidade}</span>}
              {telefone && (
                <a href={`tel:${telefone.replace(/\D/g,'')}`}
                   class="mt-1 block text-ink-muted no-underline hover:text-primary transition-colors">
                  {telefone}
                </a>
              )}
            </address>
          )}
        </div>

        {/* Coluna 2: nav */}
        {nav.length > 0 && (
          <nav class="flex flex-wrap gap-x-6 gap-y-2 content-start text-sm"
               aria-label="Navegação do rodapé">
            {nav.map(item => (
              <a href={item.href}
                 class="text-ink-muted no-underline hover:text-primary transition-colors">
                {item.label}
              </a>
            ))}
          </nav>
        )}

        {/* Coluna 3: redes */}
        {redes.length > 0 && (
          <div class="flex flex-wrap gap-3 content-start">
            {redes.map(rede => (
              <a href={rede.href}
                 target="_blank" rel="noopener noreferrer"
                 class="flex h-9 w-9 items-center justify-center rounded-[var(--radius-btn)] border border-line bg-surface text-ink-muted transition-colors hover:border-primary hover:text-primary no-underline"
                 aria-label={rede.nome}>
                <span class="text-[10px] font-bold">{rede.nome.slice(0,2).toUpperCase()}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      {/* Rodapé legal */}
      <div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6 text-xs text-ink-muted">
        <p>
          {`© ${anoFundacao && anoFundacao < anoAtual ? `${anoFundacao}–` : ''}${anoAtual} ${nomeSite}. Todos os direitos reservados.`}
        </p>
        {cnpj && <p>CNPJ {cnpj}</p>}
        {credencial && <p>{credencial}</p>}
        <button type="button" data-lf-reabrir-cookies class="underline underline-offset-2 hover:text-ink" hidden>Preferências de cookies</button>
      </div>
    </div>
  </footer>
)}

{/* ── minimal ────────────────────────────────────────────────────── */}
{variante === 'minimal' && (
  <footer class="border-t border-line bg-surface">
    <div class="container-wide flex flex-wrap items-center justify-between gap-4 py-6">
      <a href="/" class="no-underline" aria-label={`Início — ${nomeSite}`}>
        {logoSrc
          ? <img src={logoSrc} alt={logoAlt} width="110" height="28" class="h-7 w-auto" loading="lazy" />
          : <span class="font-display text-base font-semibold text-primary">{nomeSite}</span>
        }
      </a>

      {nav.length > 0 && (
        <nav class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted"
             aria-label="Navegação do rodapé">
          {nav.map(item => (
            <a href={item.href}
               class="text-ink-muted no-underline hover:text-primary transition-colors">
              {item.label}
            </a>
          ))}
        </nav>
      )}

      <p class="text-xs text-ink-muted">
        © {anoAtual} {nomeSite}
        {cnpj && <> · CNPJ {cnpj}</>}
        {credencial && <> · {credencial}</>}
        <button type="button" data-lf-reabrir-cookies class="lf-rodape-cookies underline underline-offset-2 hover:text-ink" hidden>Preferências de cookies</button>
      </p>
    </div>
  </footer>
)}

{/* ── colunas ────────────────────────────────────────────────────── */}
{variante === 'colunas' && (
  <footer class="border-t border-line bg-surface-2">
    <div class="container-wide py-14">

      {/* Grade de colunas: marca + colunas de nav */}
      <div class="grid gap-10 md:grid-cols-[200px_1fr_1fr_1fr_auto]">

        {/* Coluna marca */}
        <div>
          <a href="/" class="no-underline" aria-label={`Início — ${nomeSite}`}>
            {logoSrc
              ? <img src={logoSrc} alt={logoAlt} width="140" height="32" class="h-8 w-auto mb-4" loading="lazy" />
              : <span class="font-display text-lg font-semibold text-primary block mb-4">{nomeSite}</span>
            }
          </a>
          {(endereco || cidade || telefone) && (
            <address class="not-italic text-xs text-ink-muted leading-relaxed space-y-0.5">
              {endereco && <p>{endereco}</p>}
              {cidade && <p>{cidade}</p>}
              {telefone && (
                <a href={`tel:${telefone.replace(/\D/g,'')}`}
                   class="text-ink-muted no-underline hover:text-primary transition-colors">
                  {telefone}
                </a>
              )}
            </address>
          )}
        </div>

        {/* Colunas de nav categorizadas — omite coluna sem itens */}
        {colunas.filter(col => col.itens.length > 0).slice(0, 3).map(col => (
          <nav aria-label={col.titulo}>
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink">
              {col.titulo}
            </p>
            <ul class="list-none p-0 m-0 space-y-2">
              {col.itens.map(item => (
                <li>
                  <a href={item.href}
                     class="text-sm text-ink-muted no-underline hover:text-primary transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}

        {/* Coluna redes */}
        {redes.length > 0 && (
          <div>
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink">
              Redes
            </p>
            <div class="flex flex-wrap gap-2">
              {redes.map(rede => (
                <a href={rede.href}
                   target="_blank" rel="noopener noreferrer"
                   class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-btn)] border border-line bg-surface text-ink-muted transition-colors hover:border-primary hover:text-primary no-underline"
                   aria-label={rede.nome}>
                  <span class="text-[9px] font-bold">{rede.nome.slice(0,2).toUpperCase()}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Legal */}
      <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6 text-xs text-ink-muted">
        <p>
          {`© ${anoFundacao && anoFundacao < anoAtual ? `${anoFundacao}–` : ''}${anoAtual} ${nomeSite}. Todos os direitos reservados.`}
        </p>
        {cnpj && <p>CNPJ {cnpj}</p>}
        {credencial && <p>{credencial}</p>}
        <button type="button" data-lf-reabrir-cookies class="underline underline-offset-2 hover:text-ink" hidden>Preferências de cookies</button>
      </div>
    </div>
  </footer>
)}

{/* ── escuro ─────────────────────────────────────────────────────── */}
{variante === 'escuro' && (
  <footer class="bg-secondary text-primary-ink">
    <div class="container-wide py-14">
      <div class="grid gap-10 md:grid-cols-[220px_1fr_1fr_1fr_auto]">

        {/* Coluna marca */}
        <div>
          <a href="/" class="no-underline" aria-label={`Início — ${nomeSite}`}>
            {logoSrc
              ? <img src={logoSrc} alt={logoAlt} width="140" height="32" class="h-8 w-auto mb-4" loading="lazy" />
              : <span class="font-display text-lg font-semibold text-primary-ink block mb-3">{nomeSite}</span>
            }
          </a>
          {slogan && (
            <p class="text-sm text-primary-ink/65 leading-relaxed mb-5 max-w-[180px]">
              {slogan}
            </p>
          )}
          {redes.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {redes.map(rede => (
                <a href={rede.href}
                   target="_blank" rel="noopener noreferrer"
                   class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-ink/10 text-primary-ink/70 transition-colors hover:bg-primary-ink/20 hover:text-primary-ink no-underline"
                   aria-label={rede.nome}>
                  <span class="[&_svg]:w-[14px] [&_svg]:h-[14px]" set:html={redesIcons[rede.nome] ?? `<span class="text-[9px] font-bold">${rede.nome.slice(0,2).toUpperCase()}</span>`} />
                </a>
              ))}
            </div>
          )}
        </div>

        {/* Colunas de nav */}
        {colunas.filter(col => col.itens.length > 0).slice(0, 3).map(col => (
          <nav aria-label={col.titulo}>
            <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary-ink/50">
              {col.titulo}
            </p>
            <ul class="list-none p-0 m-0 space-y-2.5">
              {col.itens.map(item => (
                <li>
                  <a href={item.href}
                     class="text-sm text-primary-ink/75 no-underline hover:text-primary-ink transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}

        {/* Coluna contato */}
        {(telefone || email || redes.length > 0) && (
          <div>
            <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary-ink/50">Contato</p>
            <ul class="list-none p-0 m-0 space-y-2.5">
              {telefone && (
                <li class="flex items-center gap-2">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-primary-ink/50" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.72a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <a href={`tel:${telefone.replace(/\D/g,'')}`} class="text-sm text-primary-ink/75 no-underline hover:text-primary-ink">{telefone}</a>
                </li>
              )}
              {email && (
                <li class="flex items-center gap-2">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-primary-ink/50" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                  <a href={`mailto:${email}`} class="text-sm text-primary-ink/75 no-underline hover:text-primary-ink">{email}</a>
                </li>
              )}
            </ul>
          </div>
        )}
      </div>

      {/* Legal */}
      <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-primary-ink/15 pt-6 text-xs text-primary-ink/45">
        <p>
          {`© ${anoFundacao && anoFundacao < anoAtual ? `${anoFundacao}–` : ''}${anoAtual} ${nomeSite}. Todos os direitos reservados.`}
        </p>
        {cnpj && <p>CNPJ {cnpj}</p>}
        {credencial && <p>{credencial}</p>}
        <button type="button" data-lf-reabrir-cookies class="underline underline-offset-2 hover:text-primary-ink" hidden>Preferências de cookies</button>
      </div>
    </div>
  </footer>
)}

<style>
  /* variante minimal: o botão fica dentro do mesmo <p> do copyright — o
     separador só aparece junto com o botão (evita um " · " solto quando o
     site não tem banner de cookies a reabrir). */
  .lf-rodape-cookies::before { content: ' · '; }
</style>
