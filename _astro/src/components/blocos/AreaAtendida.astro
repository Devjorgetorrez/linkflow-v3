---
/**
 * AreaAtendida — cobertura geográfica do serviço.
 *
 * Corresponde ao tipo de página `area-atendida` do §3.3 do MD, aqui como
 * bloco reusável. Em serviço local, "vocês atendem meu bairro?" é a primeira
 * pergunta do visitante — e responder isso na página evita um contato perdido.
 *
 * Deliberadamente SEM campo de busca: um select com botão que não consulta
 * nada seria controle morto, e o handoff do projeto lista isso como armadilha
 * ("vai ter em breve" em vez de construir ou remover). As regiões aparecem
 * como lista real, que é a informação que o visitante procura.
 *
 * Empty state: não renderiza se regioes.length === 0.
 */

interface Props {
  eyebrow?:    string
  titulo:      string
  descricao?:  string
  regioes:     string[]
  bullets?:    string[]
  imagem?:     string
  imagemAlt?:  string
  selo?:       string
  ctaTexto?:   string
  ctaHref?:    string
  nota?:       string
}

const {
  eyebrow,
  titulo,
  descricao,
  regioes  = [],
  bullets  = [],
  imagem,
  imagemAlt = '',
  selo,
  ctaTexto,
  ctaHref,
  nota,
} = Astro.props

if (regioes.length === 0) return
---

<section class="bg-surface py-[var(--space-section)]">
  <div class="container-wide">
    <div class="grid gap-10 lg:grid-cols-[420px_1fr] lg:items-center lg:gap-14">

      {/* ── Visual ── */}
      <div class="relative overflow-hidden rounded-[var(--radius-card)] bg-secondary">
        {imagem
          ? <img src={imagem} alt={imagemAlt} width="420" height="480"
                 class="aspect-[7/8] w-full object-cover opacity-85" loading="lazy" />
          : <div class="aspect-[7/8] w-full" aria-hidden="true"></div>}

        {selo && (
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-secondary to-transparent p-6 pt-16">
            <p class="font-display text-xl font-bold leading-tight text-surface">{selo}</p>
          </div>
        )}
      </div>

      {/* ── Conteúdo ── */}
      <div>
        {eyebrow && (
          <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-primary">{eyebrow}</p>
        )}

        <h2 class="font-display text-[clamp(1.5rem,3vw,2.125rem)] font-bold leading-tight text-secondary">
          {titulo}
        </h2>

        {descricao && (
          <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-ink-muted">{descricao}</p>
        )}

        <ul class="mt-7 m-0 flex list-none flex-wrap gap-2 p-0">
          {regioes.map(r => (
            <li class="rounded-[var(--radius-pill)] border border-line bg-surface-2 px-3.5 py-1.5 text-sm text-ink">
              {r}
            </li>
          ))}
        </ul>

        {bullets.length > 0 && (
          <ul class="mt-7 m-0 flex list-none flex-col gap-2.5 p-0">
            {bullets.map(b => (
              <li class="flex gap-2.5 text-sm leading-snug text-ink">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" class="mt-0.5 shrink-0 text-success" aria-hidden="true">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}

        {nota && <p class="mt-6 text-sm text-ink-muted">{nota}</p>}

        {ctaTexto && ctaHref && (
          <a href={ctaHref}
             target={ctaHref.startsWith('http') ? '_blank' : undefined}
             rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
             class="mt-7 inline-flex items-center gap-2.5 rounded-[var(--radius-pill)] bg-success px-7 py-3.5 text-sm font-bold uppercase tracking-wide text-white no-underline transition-opacity hover:opacity-90">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.148-.669.149-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
            </svg>
            {ctaTexto}
          </a>
        )}
      </div>

    </div>
  </div>
</section>
