---
/**
 * Infraestrutura — galeria de fotos da clínica
 * Variantes: grade | destaque
 * Empty state: não renderiza se itens.length === 0.
 */

interface Item {
  src?:     string
  alt:      string
  legenda?: string
}

interface Props {
  variante?:  'grade' | 'destaque'
  titulo?:    string
  descricao?: string
  itens:      Item[]
  verMaisHref?: string
  verMaisTexto?: string
}

const {
  variante     = 'grade',
  titulo,
  descricao,
  itens        = [],
  verMaisHref,
  verMaisTexto = 'Ver galeria completa',
} = Astro.props

if (itens.length === 0) return
---

<section class="bg-surface-2 py-[var(--space-section)]">
  <div class="container-wide">
    {(titulo || descricao) && (
      <div class="mb-10 text-center">
        {titulo && (
          <h2 class="text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-secondary">{titulo}</h2>
        )}
        {descricao && (
          <p class="mt-2 text-base text-ink-muted max-w-[560px] mx-auto">{descricao}</p>
        )}
      </div>
    )}

    {variante === 'grade' && (
      <ul class={`grid gap-4 list-none p-0 m-0 ${itens.length === 2 ? 'sm:grid-cols-2' : itens.length >= 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : ''}`}>
        {itens.map(item => (
          <li class="group overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
            <div class="aspect-[4/3] overflow-hidden bg-primary/8 flex items-center justify-center">
              {item.src
                ? <img
                    src={item.src}
                    alt={item.alt}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                : <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-primary/40">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="m21 15-5-5L5 21"/>
                    </svg>
                    <span class="text-xs text-ink-muted">{item.alt}</span>
                  </div>
              }
            </div>
            {item.legenda && (
              <p class="px-4 py-3 text-sm text-ink-muted">{item.legenda}</p>
            )}
          </li>
        ))}
      </ul>
    )}

    {variante === 'destaque' && itens.length > 0 && (
      <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
        {/* Imagem principal */}
        <div class="group overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
          <div class="aspect-[16/10] overflow-hidden bg-primary/8 flex items-center justify-center">
            {itens[0].src
              ? <img src={itens[0].src} alt={itens[0].alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              : <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-primary/40">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <path d="m21 15-5-5L5 21"/>
                  </svg>
                  <span class="text-sm text-ink-muted">{itens[0].alt}</span>
                </div>
            }
          </div>
          {itens[0].legenda && <p class="px-4 py-3 text-sm text-ink-muted">{itens[0].legenda}</p>}
        </div>

        {/* Coluna direita: até 2 imagens menores */}
        {itens.length > 1 && (
          <div class="flex flex-col gap-4">
            {itens.slice(1, 3).map(item => (
              <div class="group flex-1 overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
                <div class="aspect-[16/9] overflow-hidden bg-primary/8 flex items-center justify-center">
                  {item.src
                    ? <img src={item.src} alt={item.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                    : <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-primary/40">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <rect x="3" y="3" width="18" height="18" rx="2"/>
                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <path d="m21 15-5-5L5 21"/>
                        </svg>
                        <span class="text-xs text-ink-muted">{item.alt}</span>
                      </div>
                  }
                </div>
                {item.legenda && <p class="px-3 py-2 text-xs text-ink-muted">{item.legenda}</p>}
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    {verMaisHref && (
      <div class="mt-6 text-center">
        <a href={verMaisHref}
           class="inline-flex items-center gap-1.5 text-sm font-medium text-primary no-underline hover:underline">
          {verMaisTexto}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
