---
/**
 * PostFaq — perguntas e respostas do artigo (frontmatter `faq`), no fim do
 * texto. Serve os 6 layouts (só usa tokens comuns a todos). Sem perguntas, não
 * renderiza nada. O JSON-LD FAQPage sai no <head>, por lib/post-seo.ts.
 */
interface Props { faq: { pergunta: string; resposta: string }[] }
const { faq = [] } = Astro.props
if (faq.length === 0) return
---

<section class="mt-12 pt-8 border-t border-line" aria-labelledby="faq-artigo">
  <h2 id="faq-artigo" class="text-xl font-bold text-secondary mb-4">Perguntas frequentes</h2>
  <div class="flex flex-col gap-3">
    {faq.map(f => (
      <details class="rounded-[var(--radius-card)] border border-line bg-surface-2 p-4">
        <summary class="cursor-pointer font-semibold text-secondary">{f.pergunta}</summary>
        <p class="mt-3 text-sm text-ink-muted leading-relaxed">{f.resposta}</p>
      </details>
    ))}
  </div>
</section>
