---
/**
 * AntesDepois — prova visual do resultado, par a par.
 *
 * Cumpre o papel de `Prova:midia` do §3.2: em serviço local o resultado é
 * visível, e a foto do antes/depois é a prova que mais converte. Só faz
 * sentido em nicho com resultado visual (higienização, desentupidora,
 * pintura, jardinagem, estética) — não é bloco para tema institucional.
 *
 * Sem JavaScript: os pares vêm em grade e cada um mostra as duas fotos lado
 * a lado, com rótulo. Nada de carrossel que exige script.
 *
 * Empty state: não renderiza se itens.length === 0.
 * Foto ausente: o lado correspondente cai para bloco neutro, sem quebrar o par.
 */

interface Par {
  titulo?:    string
  legenda?:   string
  antes?:     string
  depois?:    string
  antesAlt?:  string
  depoisAlt?: string
}

interface Props {
  titulo?:      string
  descricao?:   string
  itens:        Par[]
  rotuloAntes?: string
  rotuloDepois?: string
  ctaTexto?:    string
  ctaHref?:     string
}

const {
  titulo,
  descricao,
  itens = [],
  rotuloAntes  = 'Antes',
  rotuloDepois = 'Depois',
  ctaTexto,
  ctaHref,
} = Astro.props

if (itens.length === 0) return

const rotulo = 'absolute top-2.5 z-10 rounded-[var(--radius-btn)] bg-secondary/85 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-surface'
---

<section class="bg-surface-2 py-[var(--space-section)]">
  <div class="container-wide">
    {(titulo || descricao) && (
      <div class="mb-10 text-center">
        {titulo && (
          <h2 class="font-display text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-secondary">{titulo}</h2>
        )}
        {descricao && (
          <p class="mx-auto mt-3 max-w-[640px] text-base text-ink-muted">{descricao}</p>
        )}
      </div>
    )}

    <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
      {itens.map(par => (
        <li class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
          <div class="grid grid-cols-2">
            <div class="relative">
              <span class={`${rotulo} left-2.5`}>{rotuloAntes}</span>
              {par.antes
                ? <img src={par.antes} alt={par.antesAlt ?? `${par.titulo ?? 'Peça'} — ${rotuloAntes.toLowerCase()} do serviço`}
                       width="300" height="350" class="aspect-[6/7] w-full object-cover" loading="lazy" />
                : <div class="aspect-[6/7] w-full bg-surface-2" aria-hidden="true"></div>}
            </div>
            <div class="relative border-l-2 border-surface">
              <span class={`${rotulo} right-2.5`}>{rotuloDepois}</span>
              {par.depois
                ? <img src={par.depois} alt={par.depoisAlt ?? `${par.titulo ?? 'Peça'} — ${rotuloDepois.toLowerCase()} do serviço`}
                       width="300" height="350" class="aspect-[6/7] w-full object-cover" loading="lazy" />
                : <div class="aspect-[6/7] w-full bg-surface-2" aria-hidden="true"></div>}
            </div>
          </div>

          {(par.titulo || par.legenda) && (
            <div class="p-5">
              {par.titulo && <p class="font-display text-sm font-bold text-secondary">{par.titulo}</p>}
              {par.legenda && <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{par.legenda}</p>}
            </div>
          )}
        </li>
      ))}
    </ul>

    {ctaTexto && ctaHref && (
      <div class="mt-10 text-center">
        <a href={ctaHref}
           target={ctaHref.startsWith('http') ? '_blank' : undefined}
           rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
           class="inline-flex items-center gap-2.5 rounded-[var(--radius-pill)] bg-success px-8 py-3.5 text-sm font-bold uppercase tracking-wide text-white no-underline transition-opacity hover:opacity-90">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.148-.669.149-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
          </svg>
          {ctaTexto}
        </a>
      </div>
    )}
  </div>
</section>
