---
/**
 * Localizacao — endereço, contato e mapa
 * Mapa: embed do Google Maps via src (opcional) ou placeholder visual.
 */

interface Horario {
  dia:  string
  hora: string
}

interface Props {
  titulo?:     string
  descricao?:  string
  logradouro:  string
  complemento?: string
  bairro?:     string
  cidade:      string
  uf:          string
  cep:         string
  telefone?:   string
  whatsapp?:   string
  email?:      string
  horarios?:   Horario[]
  mapaSrc?:    string
  mapaHref?:   string
}

const {
  titulo      = 'Nossa localização',
  descricao,
  logradouro,
  complemento,
  bairro,
  cidade,
  uf,
  cep,
  telefone,
  whatsapp,
  email,
  horarios    = [],
  mapaSrc,
  mapaHref,
} = Astro.props

const enderecoFormatado = [logradouro, complemento].filter(Boolean).join(', ')
const cidadeFormatada   = [bairro, `${cidade} — ${uf}`, `CEP ${cep}`].filter(Boolean).join(' · ')
const waHref            = whatsapp ? `https://wa.me/${whatsapp.replace(/\D/g, '')}` : undefined
---

<section class="bg-surface py-[var(--space-section)]">
  <div class="container-wide">
    {(titulo || descricao) && (
      <div class="mb-10 text-center">
        {titulo && (
          <h2 class="text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-secondary">{titulo}</h2>
        )}
        {descricao && (
          <p class="mt-2 text-base text-ink-muted max-w-[560px] mx-auto">{descricao}</p>
        )}
      </div>
    )}

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-start">
      {/* ── Coluna de informações ── */}
      <div class="space-y-6">
        {/* Endereço */}
        <div class="flex gap-3">
          <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[var(--radius-btn)] bg-primary/10">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-secondary">Endereço</p>
            <p class="mt-0.5 text-sm text-ink">{enderecoFormatado}</p>
            <p class="text-sm text-ink-muted">{cidadeFormatada}</p>
            {mapaHref && (
              <a href={mapaHref} target="_blank" rel="noopener noreferrer"
                 class="mt-1 inline-block text-xs font-medium text-primary no-underline hover:underline">
                Ver no Google Maps →
              </a>
            )}
          </div>
        </div>

        {/* Telefone */}
        {telefone && (
          <div class="flex gap-3">
            <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[var(--radius-btn)] bg-primary/10">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.72a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-secondary">Telefone</p>
              <a href={`tel:${telefone.replace(/\D/g,'')}`} class="mt-0.5 text-sm text-ink no-underline hover:text-primary">
                {telefone}
              </a>
              {whatsapp && (
                <a href={waHref} target="_blank" rel="noopener noreferrer"
                   class="mt-0.5 flex items-center gap-1 text-xs font-medium text-primary no-underline hover:underline">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.555 4.124 1.526 5.856L.057 23.75a.5.5 0 0 0 .606.643l6.094-1.598A11.938 11.938 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.717 9.717 0 0 1-5.078-1.427l-.363-.216-3.768.988.988-3.655-.237-.378A9.718 9.718 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
                  </svg>
                  WhatsApp
                </a>
              )}
            </div>
          </div>
        )}

        {/* E-mail */}
        {email && (
          <div class="flex gap-3">
            <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[var(--radius-btn)] bg-primary/10">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-secondary">E-mail</p>
              <a href={`mailto:${email}`} class="mt-0.5 text-sm text-ink no-underline hover:text-primary">{email}</a>
            </div>
          </div>
        )}

        {/* Horários */}
        {horarios.length > 0 && (
          <div class="flex gap-3">
            <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[var(--radius-btn)] bg-primary/10">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-secondary">Horários</p>
              <ul class="mt-1 space-y-0.5 list-none p-0 m-0">
                {horarios.map(h => (
                  <li class="flex gap-3 text-sm">
                    <span class="text-ink-muted w-36 shrink-0">{h.dia}</span>
                    <span class={h.hora === 'Fechado' ? 'text-ink-muted' : 'text-ink'}>{h.hora}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </div>

      {/* ── Mapa ── */}
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface-2">
        {mapaSrc
          ? <iframe
              src={mapaSrc}
              width="100%"
              height="360"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Mapa — ${enderecoFormatado}`}
              class="block"
            />
          : <div class="flex h-[360px] flex-col items-center justify-center gap-3 p-8 text-center">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-primary/40" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <p class="text-sm font-medium text-secondary">{enderecoFormatado}</p>
              <p class="text-xs text-ink-muted">{cidadeFormatada}</p>
              {mapaHref && (
                <a href={mapaHref} target="_blank" rel="noopener noreferrer"
                   class="mt-1 rounded-[var(--radius-btn)] border border-primary px-4 py-2 text-xs font-semibold text-primary no-underline transition-colors hover:bg-primary hover:text-primary-ink">
                  Abrir no Google Maps
                </a>
              )}
            </div>
        }
      </div>
    </div>
  </div>
</section>
