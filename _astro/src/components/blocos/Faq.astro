---
/**
 * Faq — variantes: padrao | duas-colunas
 * CSS-only: details/summary nativo (sem JS).
 * Empty state: não renderiza se itens.length === 0.
 */

interface Pergunta {
  pergunta: string
  resposta: string
}

interface Props {
  variante?:  'padrao' | 'duas-colunas' | 'com-imagem'
  titulo?:    string
  descricao?: string
  itens:      Pergunta[]
  /* com-imagem */
  imagem?:    string
  imagemAlt?: string
}

const {
  variante  = 'padrao',
  titulo,
  descricao,
  itens     = [],
  imagem,
  imagemAlt = '',
} = Astro.props

if (itens.length === 0) return

// duas-colunas: divide ao meio
const metade = Math.ceil(itens.length / 2)
const col1   = itens.slice(0, metade)
const col2   = itens.slice(metade)
---

<section class="py-[var(--space-section)] bg-surface-2">
  <div class="container-wide">
    {(titulo || descricao) && (
      <div class="mb-10 text-center">
        {titulo && (
          <h2 class="text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-secondary">{titulo}</h2>
        )}
        {descricao && (
          <p class="mt-2 text-base text-ink-muted max-w-[560px] mx-auto">{descricao}</p>
        )}
      </div>
    )}

    {variante === 'padrao' && (
      <div class="max-w-[720px] mx-auto space-y-3">
        {itens.map(item => (
          <details class="group rounded-[var(--radius-card)] border border-line bg-surface">
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold text-secondary list-none">
              {item.pergunta}
              <svg class="shrink-0 transition-transform group-open:rotate-180 text-primary"
                   width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4.5 6.75L9 11.25l4.5-4.5" stroke="currentColor" stroke-width="1.75"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 pt-0 text-sm text-ink-muted leading-relaxed">
              {item.resposta}
            </div>
          </details>
        ))}
      </div>
    )}

    {variante === 'duas-colunas' && (
      <div class="grid gap-3 md:grid-cols-2">
        {[col1, col2].map(col => (
          <div class="space-y-3">
            {col.map(item => (
              <details class="group rounded-[var(--radius-card)] border border-line bg-surface">
                <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold text-secondary list-none">
                  {item.pergunta}
                  <svg class="shrink-0 transition-transform group-open:rotate-180 text-primary"
                       width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M4.5 6.75L9 11.25l4.5-4.5" stroke="currentColor" stroke-width="1.75"
                          stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="px-5 pb-5 pt-0 text-sm text-ink-muted leading-relaxed">
                  {item.resposta}
                </div>
              </details>
            ))}
          </div>
        ))}
      </div>
    )}

    {variante === 'com-imagem' && (
      <div class="grid gap-8 lg:grid-cols-[1fr_400px] lg:items-start">
        <div class="space-y-3">
          {itens.map(item => (
            <details class="group rounded-[var(--radius-card)] border border-line bg-surface">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold text-secondary list-none">
                {item.pergunta}
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-[var(--radius-btn)] bg-primary text-primary-ink transition-transform group-open:rotate-180" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
                    <path d="M4.5 6.75L9 11.25l4.5-4.5" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 pt-0 text-sm leading-relaxed text-ink-muted">
                {item.resposta}
              </div>
            </details>
          ))}
        </div>

        <div class="overflow-hidden rounded-[var(--radius-card)] border border-line">
          {imagem
            ? <img src={imagem} alt={imagemAlt} width="400" height="480"
                   class="h-full w-full object-cover" loading="lazy" />
            : <div class="flex h-full min-h-[320px] items-center justify-center bg-surface" aria-hidden="true"></div>
          }
        </div>
      </div>
    )}
  </div>
</section>
