---
/**
 * Pilares — Missão, Visão e Valores da clínica
 * 3 cards side by side em fundo claro.
 */

interface Pilar {
  icone:    string
  titulo:   string
  corpo:    string
  lista?:   string[]
}

interface Props {
  titulo?:    string
  descricao?: string
  itens:      Pilar[]
}

const { titulo, descricao, itens = [] } = Astro.props
if (itens.length === 0) return
---

<section class="bg-surface-2 py-[var(--space-section)]">
  <div class="container-wide">
    {(titulo || descricao) && (
      <div class="mb-10 text-center">
        {titulo && <h2 class="text-[clamp(1.625rem,3vw,2.25rem)] font-bold text-secondary">{titulo}</h2>}
        {descricao && <p class="mt-2 text-base text-ink-muted max-w-[560px] mx-auto">{descricao}</p>}
      </div>
    )}

    <ul class="grid gap-6 sm:grid-cols-3 list-none p-0 m-0">
      {itens.map(pilar => (
        <li class="rounded-[var(--radius-card)] border border-line bg-surface p-7">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-[var(--radius-btn)] bg-primary/10">
            <span class="text-sm font-bold text-primary" aria-hidden="true">{pilar.icone}</span>
          </div>
          <h3 class="text-base font-bold text-secondary mb-2">{pilar.titulo}</h3>
          <p class="text-sm text-ink-muted leading-relaxed">{pilar.corpo}</p>
          {pilar.lista && pilar.lista.length > 0 && (
            <ul class="mt-3 space-y-1.5 list-none p-0 m-0">
              {pilar.lista.map(item => (
                <li class="flex items-center gap-2 text-sm text-ink">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="shrink-0 text-primary" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
