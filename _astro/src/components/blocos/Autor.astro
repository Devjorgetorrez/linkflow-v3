---
/**
 * Autor — variantes: byline | assinatura
 *
 * byline:     foto + nome + cargo + data. Vai logo abaixo do H1, ANTES do corpo.
 * assinatura: caixa completa ao fim do artigo — foto, nome, cargo/credencial,
 *             bio curta e ícones de rede social.
 *
 * Extraído do padrão já validado no Tema 01, onde vivia inline em
 * components/paginas/PostDetalhe.astro. Aqui bio, cargo e redes são props — no Tema 01 a bio
 * estava fixa no código e valia para qualquer autor.
 *
 * `href` (página /autor/<slug>) liga o nome ao perfil e, na assinatura,
 * mostra "Ver todos os artigos". Os dados vêm de lib/autores.ts
 * (resolverAutor), nunca do próprio template.
 *
 * Empty state: não renderiza sem `nome`.
 */

interface Props {
  variante?:  'byline' | 'assinatura'
  nome:       string
  foto?:      string
  cargo?:     string
  bio?:       string
  data?:      string
  linkedin?:  string
  instagram?: string
  email?:     string
  href?:      string
  credencial?: string
  /** Todas as redes do autor (chave = rede). Complementa linkedin/instagram. */
  redes?:     Record<string, string | undefined>
  especialidades?: string[]
  formacao?:  string[]
  fotoAlt?:   string
  rotulo?:    string
}

const {
  variante = 'byline',
  nome,
  foto,
  cargo,
  bio,
  data,
  linkedin,
  instagram,
  email,
  redes: redesMapa,
  especialidades = [],
  formacao = [],
  fotoAlt,
  href,
  credencial,
  rotulo   = 'Escrito por',
} = Astro.props

if (!nome) return

const iniciais = nome.split(' ').slice(0, 2).map(n => n[0]).join('').toUpperCase()

const NOMES_REDE: Record<string, string> = {
  site: 'Site', linkedin: 'LinkedIn', instagram: 'Instagram', facebook: 'Facebook',
  x: 'X', youtube: 'YouTube', tiktok: 'TikTok', lattes: 'Lattes',
}
const ORDEM_REDES = ['site', 'linkedin', 'instagram', 'facebook', 'x', 'youtube', 'tiktok', 'lattes']
const mapa: Record<string, string | undefined> = { ...(redesMapa ?? {}) }
if (!mapa.linkedin && linkedin) mapa.linkedin = linkedin
if (!mapa.instagram && instagram) mapa.instagram = instagram

// Só o que o autor cadastrou. O WhatsApp da EMPRESA não entra aqui: não é contato do autor.
const redes = [
  ...ORDEM_REDES.filter(k => mapa[k]).map(k => ({ nome: NOMES_REDE[k], href: mapa[k] as string, label: `${NOMES_REDE[k]} de ${nome}` })),
  ...(email ? [{ nome: 'E-mail', href: `mailto:${email}`, label: `E-mail de ${nome}` }] : []),
]

const cargoCompleto = [cargo, credencial].filter(Boolean).join(' · ')

const icones: Record<string, string> = {
  Instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>',
  LinkedIn: '<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  Facebook: '<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.026 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>',
  X: '<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  YouTube: '<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
  TikTok: '<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>',
  Site: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>',
  Lattes: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>',
  'E-mail': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>',
  WhatsApp: '<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>',
}
---

{variante === 'byline' && (
  <div class="flex items-center gap-3">
    {foto
      ? <img src={foto} alt={fotoAlt || nome} width="44" height="44"
             class="h-11 w-11 rounded-full object-cover border-2 border-surface shadow-sm"
             loading="eager" />
      : <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
          {iniciais}
        </span>
    }
    <div>
      <p class="text-sm font-semibold text-ink leading-tight">
        {href ? <a href={href} class="text-ink no-underline hover:text-primary">{nome}</a> : nome}
      </p>
      <p class="text-xs text-ink-muted leading-tight mt-0.5">
        {cargo}{cargo && data ? ' · ' : ''}{data}
      </p>
    </div>
  </div>
)}

{variante === 'assinatura' && (
  <aside class="mt-10 flex flex-col gap-5 rounded-[var(--radius-card)] border border-line bg-surface-2 p-6 sm:flex-row sm:items-start">
    {foto
      ? <img src={foto} alt={fotoAlt || nome} width="80" height="80"
             class="h-20 w-20 shrink-0 rounded-full object-cover border-2 border-surface shadow-sm"
             loading="lazy" />
      : <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xl font-bold text-primary">
          {iniciais}
        </span>
    }

    <div class="min-w-0">
      <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-primary">{rotulo}</p>
      <p class="font-display text-lg font-bold text-secondary leading-tight">
        {href ? <a href={href} class="text-secondary no-underline hover:text-primary">{nome}</a> : nome}
      </p>
      {cargoCompleto && <p class="mt-0.5 text-sm font-medium text-ink-muted">{cargoCompleto}</p>}
      {bio && <p class="mt-3 text-sm leading-relaxed text-ink-muted">{bio}</p>}
      {especialidades.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`Especialidades de ${nome}`}>
          {especialidades.map(e => (
            <li class="rounded-[var(--radius-pill)] border border-line bg-surface px-2.5 py-0.5 text-xs text-ink-muted">{e}</li>
          ))}
        </ul>
      )}
      {formacao.length > 0 && (
        <p class="mt-2 text-xs leading-relaxed text-ink-muted"><span class="font-semibold text-ink">Formação:</span> {formacao.join(' · ')}</p>
      )}
      {href && (
        <p class="mt-3 text-sm">
          <a href={href} class="font-semibold text-primary no-underline hover:underline">Ver todos os artigos de {nome}</a>
        </p>
      )}

      {redes.length > 0 && (
        <div class="mt-4 flex gap-2">
          {redes.map(r => (
            <a href={r.href}
               target={r.href.startsWith('mailto:') ? undefined : '_blank'}
               rel={r.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
               aria-label={r.label}
               class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary no-underline transition-colors hover:bg-primary hover:text-primary-ink">
              <Fragment set:html={icones[r.nome]} />
            </a>
          ))}
        </div>
      )}
    </div>
  </aside>
)}
