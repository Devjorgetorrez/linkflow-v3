---
/**
 * BotaoWhatsApp — botão flutuante fixo (canto inferior direito), em todas as páginas.
 * Renderizado pelos layouts. Não aparece sem número (nap.whatsapp) ou com
 * `whatsappFlutuante: false` no config. Nunca inventa número nem mensagem.
 *
 * Decisão: a página de contato mantém os botões de WhatsApp próprios do
 * formulário e este flutuante também — é o mesmo canal, consistente em todas
 * as páginas, e não vale uma exceção por rota.
 * Cor: verde escuro da marca (#0B7A45) — o #25D366 puro com ícone branco não
 * passa em contraste AA (≈2:1). Respeita safe-area (iPhone/rodapé do sistema).
 * z-index 40: abaixo de modais/banner de cookies (que usam 50+).
 */
interface Props {
  whatsapp?:  string
  ativo?:     boolean
  mensagem?:  string
}
const { whatsapp, ativo = true, mensagem } = Astro.props
const numero = (whatsapp || '').replace(/\D/g, '')
const texto  = (mensagem && mensagem.trim()) || 'Olá! Vim pelo site e gostaria de mais informações.'
const href   = `https://wa.me/${numero}?text=${encodeURIComponent(texto)}`
---

{ativo && numero && (
  <a href={href} target="_blank" rel="noopener noreferrer" aria-label="Falar no WhatsApp"
     data-botao-whatsapp class="lf-wa-flutuante">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.148-.669.149-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
  </a>
)}

<style>
  .lf-wa-flutuante {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: #0B7A45;
    color: #fff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .lf-wa-flutuante:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgb(0 0 0 / 0.32); }
  .lf-wa-flutuante:focus-visible { outline: 3px solid #fff; outline-offset: 2px; box-shadow: 0 0 0 5px #0B7A45; }
  @media (prefers-reduced-motion: reduce) { .lf-wa-flutuante { transition: none; } }
  @media print { .lf-wa-flutuante { display: none; } }
</style>
