---
/**
 * FormExtras — peças que TODO formulário de captação do site precisa.
 * Vai como último filho do <form data-lf-form>; o comportamento está em
 * src/scripts/form-contato.ts (carregado por FormContato.astro).
 *   - honeypot `_hp`: campo fora da tela, invisível para pessoas
 *   - região de avisos (aria-live) para erros gerais e a prévia
 *   - bloco de sucesso, com o botão "Continuar no WhatsApp" (só se houver número)
 */
interface Props { whatsapp?: string }
const { whatsapp } = Astro.props
const numero = (whatsapp || '').replace(/\D/g, '')
const temWhats = !!numero
---

<div data-lf-manter aria-hidden="true"
     style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
  <label>Não preencha este campo
    <input type="text" name="_hp" value="" tabindex="-1" autocomplete="off" />
  </label>
</div>

<div data-lf-manter data-lf-status tabindex="-1" aria-live="polite"
     class="text-sm font-medium text-ink outline-none empty:hidden"></div>

<div data-lf-manter data-lf-sucesso hidden tabindex="-1" class="rounded-[var(--radius-card)] border border-line bg-surface p-6 text-ink outline-none">
  <p data-lf-msg class="text-base font-semibold text-secondary"></p>
  {temWhats && (
    <p class="mt-4">
      <a data-lf-wa href={`https://wa.me/${numero}`} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 rounded-[var(--radius-btn)] bg-[#0B7A45] px-5 py-3 text-sm font-semibold text-white no-underline transition-opacity hover:opacity-90">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.148-.669.149-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
        Continuar no WhatsApp
      </a>
    </p>
  )}
</div>
