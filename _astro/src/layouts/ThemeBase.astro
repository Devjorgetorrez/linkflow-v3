---
import '../styles/global.css'
import { site } from '../config/site.ts'
import { urlAbsoluta } from '../lib/schema.ts'
import BotaoWhatsApp from '../components/blocos/BotaoWhatsApp.astro'

interface Props {
  titulo:          string
  metaDescription: string
  canonical:       string
  jsonLd?:         object | object[]
  nodeId?:         string
  noindex?:        boolean
}

const {
  titulo,
  metaDescription,
  canonical,
  jsonLd,
  nodeId = 'page',
  noindex = false,
} = Astro.props

const ogDescricao = metaDescription || site.descricao
const ogImagem    = urlAbsoluta(site, site.ogImagem)
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap.xml" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {site.favicon && <link rel="icon" href={site.favicon} />}

  {/* Open Graph / Twitter */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.nome} />
  <meta property="og:title" content={titulo} />
  {ogDescricao && <meta property="og:description" content={ogDescricao} />}
  <meta property="og:url" content={canonical} />
  {ogImagem && <meta property="og:image" content={ogImagem} />}
  <meta property="og:locale" content="pt_BR" />
  <meta name="twitter:card" content={ogImagem ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={titulo} />
  {ogDescricao && <meta name="twitter:description" content={ogDescricao} />}
  {ogImagem && <meta name="twitter:image" content={ogImagem} />}


  {/* Fonts: Plus Jakarta Sans (600,700) + Inter (400,500,600,700) */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  {/* JSON-LD @graph */}
  {/* URL do painel (envio do formulário de contato); sem ela o formulário não envia */}
  {site.painelUrl && <meta name="lf-painel-url" content={site.painelUrl} />}

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body class="bg-surface font-sans text-ink antialiased">
  <main data-node-id={nodeId}>
    <slot />
  </main>
  <script>import '../scripts/utm.ts'</script>
  <BotaoWhatsApp whatsapp={site.nap?.whatsapp} ativo={site.whatsappFlutuante !== false} mensagem={site.whatsappMensagem} />
</body>
</html>
